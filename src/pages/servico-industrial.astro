---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
import StatsBand from '../components/StatsBand.astro';
import VantagensBand from '../components/VantagensBand.astro';
import ProcessoSection from '../components/ProcessoSection.astro';
import FaqBand from '../components/FaqBand.astro';
---

<Layout
  title="Energia Solar Industrial - Cordeiro Energia | Grandes Potências"
  description="Sistema de energia solar para indústrias com alto consumo. Grandes potências até 5MW. Consultoria energética completa."
  ogImage="/og-image.svg"
>
  <Header />

  <main>
    <!-- Hero -->
    <section style="position: relative; min-height: 70vh; display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 6rem 1.5rem 4rem;">
      <div style="position: absolute; inset: 0; background-image: url('/cat-empresa.webp'); background-size: cover; background-position: center; z-index: 0;"></div>
      <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(10,10,10,0.92) 0%, rgba(254,92,23,0.7) 100%); z-index: 1;"></div>
      <div style="position: relative; z-index: 2; max-width: 48rem; margin: 0 auto; text-align: center;">
        <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1.25rem; border-radius: 9999px; background: rgba(254,92,23,0.15); border: 1px solid rgba(254,92,23,0.3); margin-bottom: 1.5rem;">
          <span style="font-size: 1.25rem;">🏭</span>
          <span style="font-size: 0.875rem; color: #FE5C17; font-weight: 600;">Solução Industrial</span>
        </div>
        <h1 style="font-size: clamp(2.25rem, 5vw, 3.5rem); font-weight: 800; color: #fff; line-height: 1.15; margin-bottom: 1.5rem;">
          Energia Solar <br>
          <span style="color: #FE5C17;">Industrial</span>
        </h1>
        <p style="font-size: 1.125rem; color: rgba(255,255,255,0.8); margin-bottom: 2.5rem; max-width: 36rem; margin-left: auto; margin-right: auto;">
          Grandes potências para indústrias com alto consumo energético. Sistemas de até 5MW com monitoramento avançado e manutenção preventiva.
        </p>
        <a
          href="https://wa.me/5538997350343?text=Ol%C3%A1%2C%20gostaria%20de%20um%20or%C3%A7amento%20para%20energia%20solar%20industrial"
          target="_blank"
          rel="noopener noreferrer"
          style="display: inline-block; padding: 1rem 2.5rem; background: linear-gradient(135deg, #FE5C17 0%, #FF8F00 100%); color: #fff; font-size: 1.125rem; font-weight: 700; border-radius: 9999px; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 4px 24px rgba(254,92,23,0.4);"
        >
          Solicitar Proposta Industrial
        </a>
      </div>
    </section>

    <!-- Stats Widget -->
    <StatsBand
      stats={[
        {
          icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>',
          label: 'Potência máxima',
          prefix: 'Até',
          count: 5,
          suffix: 'MW',
        },
        {
          icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>',
          label: 'Garantia dos painéis',
          count: 25,
          suffix: 'anos',
        },
        {
          icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 20v-9M12 20V4M19 20v-6M3 20h18"/></svg>',
          label: 'Payback médio',
          text: '4-6',
          suffix: 'anos',
        },
        {
          icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
          label: 'Manutenção completa',
          text: 'Inclusa',
        },
      ]}
    />

    <!-- Vantagens -->
    <VantagensBand
      tag="VANTAGENS"
      titleHtml="Soluções para <span>indústrias</span>"
      subtitle="Tecnologia e escala para transformar o custo energético da sua indústria em vantagem competitiva."
      benefits={[
        { icon: '⚡', title: 'Até 5MW de potência', text: 'Sistemas de grande porte projetados para suprir a demanda energética industrial com eficiência máxima.' },
        { icon: '📊', title: 'Monitoramento avançado', text: 'Plataforma completa com relatórios de desempenho em tempo real e alertas inteligentes.' },
        { icon: '🔧', title: 'Manutenção preventiva', text: 'Contratos de manutenção com SLA garantido para máxima disponibilidade do sistema.' },
        { icon: '💰', title: 'Economia de milhões', text: 'Indústrias podem economizar R$ 50.000 ou mais por mês na conta de energia.' },
        { icon: '📈', title: 'Venda de energia excedente', text: 'Gere receita adicional vendendo energia excedente em leilões do mercado livre.' },
        { icon: '🤝', title: 'Consultoria energética', text: 'Análise completa do consumo e otimização do sistema para máximo retorno sobre investimento.' },
      ]}
    />

    <!-- Como Funciona -->
    <ProcessoSection
      steps={[
        { text: 'Analisamos o consumo da sua indústria e dimensionamos o sistema para a sua demanda real.' },
        { text: 'Projetamos o sistema ideal para o consumo e as características da sua planta.' },
        {},
        { text: 'Instalação executada por equipe especializada, com manutenção preventiva inclusa.' },
      ]}
    />

    <!-- FAQ -->
    <FaqBand
      ctaHref="https://wa.me/5538997350343?text=Ol%C3%A1%2C%20tenho%20uma%20d%C3%BAvida%20sobre%20energia%20solar%20industrial"
      items={[
        {
          question: 'Até qual potência vocês atendem?',
          answer: 'Sistemas de até 5MW, projetados para suprir a demanda energética industrial com eficiência máxima.',
        },
        {
          question: 'Como funciona a manutenção?',
          answer: 'Contratos de manutenção com SLA garantido para máxima disponibilidade do sistema, incluindo monitoramento avançado em tempo real.',
        },
        {
          question: 'O sistema atende picos de consumo?',
          answer: 'Sim. Os sistemas são dimensionados para suprir a demanda energética industrial, com relatórios de desempenho e alertas inteligentes.',
        },
        {
          question: 'Vocês cuidam das aprovações?',
          answer: 'Sim, cuidamos de todo o processo burocrático junto à concessionária e aos órgãos responsáveis pela ligação do sistema.',
        },
      ]}
    />

    <CtaSection />
  </main>

  <FloatingWhatsApp />
  <Footer />
</Layout>
