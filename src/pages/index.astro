---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const services = [
  { num: '01', icon: '☀️', title: 'Energia Solar', desc: 'Sistema completo com economia de até 95% na conta de luz.', badge: 'MAIS VENDIDO', href: '/servico-residencial', img: '/servico-residencial.jpg' },
  { num: '02', icon: '🏢', title: 'Comercial', desc: 'Soluções sob medida para empresas e comércios.', badge: '', href: '/servico-comercial', img: '/servico-comercial.jpg' },
  { num: '03', icon: '🏭', title: 'Industrial', desc: 'Grandes potências para indústrias com alto consumo.', badge: '', href: '/servico-industrial', img: '/hero-solar.jpg' },
