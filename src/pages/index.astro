  <script>
    function initSim() {
      const input = document.getElementById('bill') as HTMLInputElement | null;
      if (!input || input.dataset.ready === '1') return;
      input.dataset.ready = '1';

      const out = document.getElementById('billOut');
      const vAtual = document.getElementById('vAtual');
      const vNovo = document.getElementById('vNovo');
      const vMes = document.getElementById('vMes');
      const vAno = document.getElementById('vAno');
      const vCo2 = document.getElementById('vCo2');
      const barAtual = document.getElementById('barAtual');
      const barNovo = document.getElementById('barNovo');

      const brl = (n: number) => n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });
      const num = (n: number) => n.toLocaleString('pt-BR', { maximumFractionDigits: 0 });

      const render = () => {
        const bill = Number(input.value);
        const share = ((bill - Number(input.min)) / (Number(input.max) - Number(input.min))) * 100;
        const novo = bill * 0.12;
        const mes = bill - novo;
        const kwh = bill / 0.7;
        const co2 = (kwh * 12 * 38.5) / 1000;

        input.style.setProperty('--pct', share + '%');
        if (out) out.textContent = brl(bill);
        if (vAtual) vAtual.textContent = brl(bill);
        if (vNovo) vNovo.textContent = brl(novo);
        if (vMes) vMes.textContent = brl(mes);
        if (vAno) vAno.textContent = brl(mes * 12);
        if (vCo2) vCo2.textContent = num(co2) + ' kg';
        if (barAtual) barAtual.style.width = share + '%';
        if (barNovo) barNovo.style.width = share * 0.12 + '%';
      };

      input.addEventListener('input', render);
      render();
    }

    function initFlow() {
      document.querySelectorAll<HTMLElement>('[data-flow]').forEach((root) => {
        if (root.dataset.ready === '1') return;
        root.dataset.ready = '1';

        const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.flow-tab'));
        const panels = Array.from(root.querySelectorAll<HTMLElement>('.flow-panel'));
        if (!tabs.length) return;

        const select = (idx: number) => {
          tabs.forEach((t, i) => {
            const on = i === idx;
            t.setAttribute('aria-selected', String(on));
            t.tabIndex = on ? 0 : -1;
          });
          panels.forEach((p, i) => { p.hidden = i !== idx; });
        };

        tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));

        root.addEventListener('keydown', (ev) => {
          const cur = tabs.indexOf(document.activeElement as HTMLButtonElement);
          if (cur < 0) return;
          let next: number;
          if (ev.key === 'ArrowRight' || ev.key === 'ArrowDown') next = (cur + 1) % tabs.length;
          else if (ev.key === 'ArrowLeft' || ev.key === 'ArrowUp') next = (cur - 1 + tabs.length) % tabs.length;
          else if (ev.key === 'Home') next = 0;
          else if (ev.key === 'End') next = tabs.length - 1;
          else return;
          ev.preventDefault();
          select(next);
          tabs[next].focus();
        });

        if (window.matchMedia('(min-width: 900px) and (hover: hover)').matches) {
          root.addEventListener('pointerover', (ev) => {
            const hit = (ev.target as HTMLElement | null)?.closest?.('.flow-tab');
            if (hit instanceof HTMLButtonElement) select(tabs.indexOf(hit));
          });
        }

        const current = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
        select(current < 0 ? 0 : current);
      });
    }

    function initSays() {
      document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
        if (root.dataset.ready === '1') return;
        root.dataset.ready = '1';

        const track = root.querySelector<HTMLElement>('.says-track');
        const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
        const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
        const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
        const next = root.querySelector<HTMLButtonElement>('[data-next]');
        const count = root.querySelector<HTMLElement>('[data-count]');
        const bar = root.querySelector<HTMLElement>('[data-progress]');
        if (!track || slides.length < 2) return;

        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const total = slides.length;
        let idx = 0;

        const render = () => {
          track.style.setProperty('--i', String(idx));
          slides.forEach((s, i) => {
            const on = i === idx;
            s.classList.toggle('is-active', on);
            s.setAttribute('aria-hidden', String(!on));
          });
          dots.forEach((d, i) => {
            const on = i === idx;
            d.classList.toggle('is-on', on);
            d.setAttribute('aria-current', String(on));
          });
          if (count) count.textContent = `${String(idx + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
        };

        const runBar = () => {
          if (!bar || reduce) return;
          bar.classList.remove('is-run');
          void bar.offsetWidth;
          bar.classList.add('is-run');
        };

        const go = (n: number, manual = false) => {
          idx = ((n % total) + total) % total;
          render();
          if (manual) runBar();
        };

        bar?.addEventListener('animationend', () => go(idx + 1));
        prev?.addEventListener('click', () => go(idx - 1, true));
        next?.addEventListener('click', () => go(idx + 1, true));
        dots.forEach((d, i) => d.addEventListener('click', () => go(i, true)));

        root.addEventListener('keydown', (ev) => {
          if (ev.key === 'ArrowLeft') { go(idx - 1, true); }
          else if (ev.key === 'ArrowRight') { go(idx + 1, true); }
          else return;
          ev.preventDefault();
        });

        const view = root.querySelector<HTMLElement>('.says-viewport');
        if (view) {
          let sx = 0;
          const end = (ev: PointerEvent) => {
            view.classList.remove('is-drag');
            const dx = ev.clientX - sx;
            if (Math.abs(dx) > 45) go(idx + (dx < 0 ? 1 : -1), true);
          };
          view.addEventListener('pointerdown', (ev) => {
            sx = ev.clientX;
            view.classList.add('is-drag');
          });
          view.addEventListener('pointerup', end);
          view.addEventListener('pointercancel', () => view.classList.remove('is-drag'));
          view.addEventListener('pointerleave', () => view.classList.remove('is-drag'));
        }

        render();
        if (!reduce) runBar();
      });
    }

    document.addEventListener('astro:page-load', initSim);
    document.addEventListener('DOMContentLoaded', initSim);
    document.addEventListener('astro:page-load', initFlow);
    document.addEventListener('DOMContentLoaded', initFlow);
    document.addEventListener('astro:page-load', initSays);
    document.addEventListener('DOMContentLoaded', initSays);
  </script>
</Layout>
