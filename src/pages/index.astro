                <div style="font-size:0.65rem;color:#6b7280;">Resposta rápida</div>
              </div>
            </div>
          </div>

          <!-- Lado Direito - Conteúdo -->
          <div>
            <div class="tag" style="margin-bottom:1.5rem;">
              <svg style="width:0.75rem;height:0.75rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              QUEM SOMOS
            </div>

            <h2 style="font-size:2.75rem;font-weight:800;color:#111;line-height:1.15;margin-bottom:1.5rem;letter-spacing:-0.02em;">
              Especialistas em <span style="color:#FE5C17;">energia solar</span>
            </h2>

            <p style="font-size:1.05rem;color:#6b7280;line-height:1.8;margin-bottom:2rem;">
              A <strong style="color:#111;">Cordeiro Energia</strong> é referência em projetos de energia solar em Curvelo/MG. Cuidamos de todo o processo — do projeto à instalação — até a economia chegar na sua conta.
            </p>

            <!-- Features Grid -->
            <div class="sobre-features" style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:2.5rem;">
              <div style="display:flex;align-items:flex-start;gap:0.75rem;padding:1rem;border-radius:0.75rem;background:#f9fafb;transition:all 0.2s;">
