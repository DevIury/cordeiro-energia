              </div>
            </div>

            <!-- CTA Row -->
            <div class="cta-row">
              <a href="#contato" class="cta-btn cta-orange">CONHEÇA A CORDEIRO
                <svg style="width:0.875rem;height:0.875rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
