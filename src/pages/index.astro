  { cat: 'ECONOMIA', title: 'Erros Comuns ao Escolher Energia Solar', desc: 'Dicas práticas para não errar na escolha.', date: '10 Jul 2026', href: '/blog/erros-comuns-energia-solar', img: '/servico-comercial.jpg' },
