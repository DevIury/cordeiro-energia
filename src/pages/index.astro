      <div class="container">
        <div class="urgencia-card">
          <div class="urg-icon-wrap">
            <div class="urg-icon-ring"></div>
            <div class="urg-icon-ring urg-icon-ring-2"></div>
            <svg style="width:1.25rem;height:1.25rem;color:#FE5C17;z-index:1;" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
          </div>
          <strong class="urg-title">OFERTA ESPECIAL</strong>
          <span class="urg-desc">Orçamento gratuito + análise de consumo. Vagas limitadas!</span>
