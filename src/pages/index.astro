    .track-fill { display: block; height: 100%; border-radius: 999px; background: linear-gradient(90deg, #6b7383, var(--prata)); transition: width 0.4s cubic-bezier(0.2, 0.7, 0.3, 1); }
    .track-sol .track-fill { background: linear-gradient(90deg, var(--sol-pro), var(--sol), var(--sol-luz)); }

    .out { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; border-top: 1px solid rgba(168, 176, 189, 0.16); padding-top: 1.4rem; }
    .out-cell { min-width: 0; }
    .out-cell strong { display: block; font-size: clamp(0.95rem, 2vw, 1.25rem); color: #fff; font-weight: 700; margin-top: 0.45rem; letter-spacing: -0.02em; }
    .out-cell:first-child strong { color: var(--sol); }
    .panel-note { margin-top: 1.4rem; font-size: 0.72rem; line-height: 1.7; color: #5b6373; }

    /* ============ SEGMENTOS ============ */
    .segs {
      padding: clamp(3.5rem, 8vw, 6.5rem) 0;
      background-color: var(--dia);
      background-image: var(--horizonte), radial-gradient(46rem 24rem at 90% -8%, rgba(254, 92, 23, 0.14), transparent 70%);
      background-size: 100% 2px, auto;
      background-repeat: no-repeat, no-repeat;
      background-position: top left, right top;
    }
    .bento { display: grid; gap: clamp(0.75rem, 1.6vw, 1.1rem); grid-template-columns: 1fr; }

    .bento-intro {
      position: relative; overflow: hidden; border-radius: 1.15rem;
      background-color: var(--painel);
      background-image:
        radial-gradient(34rem 20rem at 118% -25%, rgba(254, 92, 23, 0.42), transparent 70%),
        linear-gradient(to right, rgba(168, 176, 189, 0.09) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(168, 176, 189, 0.09) 1px, transparent 1px);
      background-size: auto, 44px 44px, 44px 44px;
      padding: clamp(1.75rem, 3.5vw, 2.75rem);
      display: flex; flex-direction: column; align-items: flex-start; justify-content: center;
      box-shadow: 0 24px 50px rgba(10, 14, 23, 0.16);
    }
    .bento-intro h2 { color: #fff; font-size: clamp(1.9rem, 3.6vw, 2.75rem); font-weight: 700; letter-spacing: -0.04em; line-height: 1.05; margin: 1rem 0 0.85rem; }
    .bento-intro p { color: var(--prata); font-size: 1rem; line-height: 1.7; margin-bottom: 1.5rem; max-width: 34ch; }
    .bento-cta {
      display: inline-flex; align-items: center; gap: 0.55rem; text-decoration: none;
      color: #FE5C17; font-weight: 700; font-size: 0.85rem;
      border-bottom: 1px solid rgba(255, 194, 77, 0.4); padding-bottom: 0.25rem;
      transition: gap 0.25s, border-color 0.25s;
    }
    .bento-cta svg { width: 0.9rem; height: 0.9rem; }
    .bento-cta:hover { gap: 0.9rem; border-color: #FE5C17; }
    .bento-cta:focus-visible { outline: 2px solid var(--sol-luz); outline-offset: 4px; }

    .tile {
      position: relative; display: block; overflow: hidden; isolation: isolate;
      min-height: 220px; border-radius: 1.15rem; text-decoration: none; color: #fff;
      background: #141a26;
      transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 0.45s;
    }
    .tile-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.3, 1); }
    .tile-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10, 14, 23, 0.28) 0%, rgba(10, 14, 23, 0.58) 45%, rgba(10, 14, 23, 0.93) 100%); transition: background 0.45s; }
    .tile-cat {
      position: absolute; top: clamp(0.9rem, 2vw, 1.25rem); left: clamp(0.9rem, 2vw, 1.25rem); z-index: 2;
      font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
      font-size: 0.6rem; letter-spacing: 0.2em; font-weight: 700; color: #FE5C17;
      background: rgba(10, 14, 23, 0.5); border: 1px solid rgba(255, 255, 255, 0.18);
      backdrop-filter: blur(6px); padding: 0.35rem 0.7rem; border-radius: 999px;
    }
    .tile-body {
      position: absolute; left: clamp(0.95rem, 2vw, 1.35rem); right: 4.25rem;
      bottom: clamp(0.95rem, 2vw, 1.35rem); z-index: 2;
    }
    .tile-title { display: block; font-size: clamp(1.15rem, 2vw, 1.55rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 0.45rem; }
    .tile-desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 0.83rem; line-height: 1.55; color: rgba(255, 255, 255, 0.72); max-width: 34ch; }
    .tile-go {
      position: absolute; right: clamp(0.95rem, 2vw, 1.35rem); bottom: clamp(0.95rem, 2vw, 1.35rem); z-index: 2;
      width: 2.5rem; height: 2.5rem; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.35);
      display: flex; align-items: center; justify-content: center; color: #fff;
      transition: all 0.4s cubic-bezier(0.2, 0.7, 0.3, 1);
    }
    .tile-go svg { width: 0.95rem; height: 0.95rem; }
    .tile::after {
      content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; z-index: 3;
      background-image: var(--horizonte); transform: scaleX(0); transform-origin: left;
      transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
    }
    .tile:hover, .tile:focus-visible { transform: translateY(-4px); box-shadow: 0 26px 50px rgba(10, 14, 23, 0.22); }
    .tile:hover .tile-img, .tile:focus-visible .tile-img { transform: scale(1.07); }
    .tile:hover .tile-scrim, .tile:focus-visible .tile-scrim { background: linear-gradient(180deg, rgba(10, 14, 23, 0.16) 0%, rgba(10, 14, 23, 0.5) 45%, rgba(10, 14, 23, 0.95) 100%); }
    .tile:hover .tile-go, .tile:focus-visible .tile-go { background: var(--sol); border-color: var(--sol); transform: translateX(4px); }
    .tile:hover::after, .tile:focus-visible::after { transform: scaleX(1); }
    .tile:focus-visible { outline: 2px solid var(--sol); outline-offset: 3px; }

    @media (min-width: 640px) {
      .bento { grid-template-columns: repeat(2, 1fr); }
      .bento-intro { grid-column: 1 / -1; }
      .tile:first-of-type { grid-column: 1 / -1; min-height: 270px; }
    }

    @media (min-width: 1024px) {
      .bento { grid-template-columns: repeat(12, 1fr); grid-auto-rows: minmax(168px, auto); }
      .bento-intro { grid-column: 1 / span 4; grid-row: 1 / span 2; }
      .tile:nth-of-type(1) { grid-column: 5 / span 4; grid-row: 1 / span 2; min-height: 0; }
      .tile:nth-of-type(2) { grid-column: 9 / span 4; grid-row: 1; }
      .tile:nth-of-type(3) { grid-column: 9 / span 4; grid-row: 2; }
      .tile:nth-of-type(4) { grid-column: 1 / span 4; grid-row: 3; }
      .tile:nth-of-type(5) { grid-column: 5 / span 4; grid-row: 3; }
      .tile:nth-of-type(6) { grid-column: 9 / span 4; grid-row: 3; }
      .tile-title { font-size: clamp(1.3rem, 1.7vw, 1.6rem); }
    }

    /* ============ SOBRE + NÚMEROS ============ */
    .about {
      padding: clamp(3.25rem, 7vw, 5.75rem) 0 0;
      background-color: var(--dia-2);
      background-image: var(--horizonte), radial-gradient(46rem 24rem at 97% 4%, rgba(254, 92, 23, 0.16), transparent 70%);
      background-size: 100% 2px, auto;
      background-repeat: no-repeat, no-repeat;
      background-position: top left, right top;
    }

    .about-split { display: grid; gap: clamp(1.75rem, 4vw, 3.5rem); }
    @media (min-width: 900px) {
      .about-split { grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr); gap: clamp(2.5rem, 4vw, 4.5rem); }
      .claim { align-self: center; }
      .about-media { min-height: clamp(20rem, 32vw, 28rem); }
    }

    .about-media { position: relative; margin: 0; overflow: hidden; aspect-ratio: 16 / 10; background: #d6dbe3; }
    @media (min-width: 900px) { .about-media { aspect-ratio: auto; } }
    .about-media img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 62%; }
    .about-media::before {
      content: ''; position: absolute; top: 0; left: 0; z-index: 2; pointer-events: none;
      width: clamp(3rem, 5vw, 5rem); height: clamp(3rem, 5vw, 5rem);
      border-top: 4px solid var(--sol); border-left: 4px solid var(--sol);
    }
    .about-media::after {
      content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
      background: linear-gradient(0deg, rgba(10, 14, 23, 0.68) 0%, rgba(10, 14, 23, 0.1) 34%, transparent 52%);
    }
    .about-pin {
      position: absolute; left: clamp(0.75rem, 2vw, 1.25rem); bottom: clamp(0.75rem, 2vw, 1.25rem); z-index: 3;
      display: inline-flex; align-items: center; gap: 0.6rem;
      padding: 0.6rem 0.95rem; background: rgba(10, 14, 23, 0.9);
      box-shadow: 0 12px 32px rgba(10, 14, 23, 0.4);
    }
    .about-pin svg { width: 1.05rem; height: 1.05rem; flex: none; color: #FE5C17; }
    .about-pin-t { font-size: 0.64rem; line-height: 1.3; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255, 255, 255, 0.6); }
    .about-pin-t b { display: block; font-size: 0.95rem; letter-spacing: -0.01em; text-transform: none; color: #fff; }

    .claim { min-width: 0; }
    .claim h2 {
      font-size: clamp(2.05rem, 4.6vw, 3.5rem); font-weight: 700;
      letter-spacing: -0.042em; line-height: 1.04; color: #111;
      text-wrap: balance; margin-top: clamp(0.9rem, 2vw, 1.3rem);
    }
    .claim-lead { margin-top: clamp(1.1rem, 2.2vw, 1.5rem); color: #52525b; font-size: clamp(1rem, 1.1vw, 1.09rem); line-height: 1.75; max-width: 56ch; }
    .claim-lead strong { color: #111; font-weight: 700; }
    .claim-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: clamp(1.5rem, 3vw, 2.25rem); }

    .ledger-band {
      position: relative; isolation: isolate;
      margin-top: clamp(2.5rem, 6vw, 4.5rem);
      background-color: var(--painel);
      padding: clamp(2.75rem, 6vw, 4.75rem) 0 clamp(1.75rem, 4vw, 2.75rem);
    }
    .ledger-band::before {
      content: ''; position: absolute; inset: 0; z-index: -1;
      background: url('/sobre-solar.webp') center 86% / cover no-repeat;
    }
    .ledger-band::after {
      content: ''; position: absolute; inset: 0; z-index: -1;
      background-image: var(--horizonte),
        linear-gradient(180deg, rgba(10, 14, 23, 0.93) 0%, rgba(10, 14, 23, 0.84) 45%, rgba(10, 14, 23, 0.96) 100%);
      background-size: 100% 2px, auto;
      background-repeat: no-repeat, no-repeat;
      background-position: top left, center;
    }
    .ledger-band > .container { position: relative; z-index: 1; }

    .ledger {
      display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
      border-top: 2px solid rgba(255, 255, 255, 0.88);
      border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    }
    .ledger-item { min-width: 0; padding: clamp(1.3rem, 3vw, 1.75rem) 0; border-bottom: 1px solid rgba(255, 255, 255, 0.13); }
    .ledger-item:nth-child(odd) { padding-right: clamp(1rem, 2.5vw, 1.75rem); }
    .ledger-item:nth-child(even) { padding-left: clamp(1rem, 2.5vw, 1.75rem); border-left: 1px solid rgba(255, 255, 255, 0.13); }
    .ledger-item:nth-child(n+3) { border-bottom: none; }
    .ledger-num {
      display: flex; align-items: baseline; gap: 0.12em;
      font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
      font-variant-numeric: tabular-nums; font-weight: 700;
      font-size: clamp(2rem, 5vw, 4.25rem); letter-spacing: -0.06em;
      line-height: 1; color: #fff;
    }
    .ledger .num-val { font-size: inherit; font-weight: inherit; color: inherit; letter-spacing: inherit; line-height: inherit; }
    .ledger-num sup { font-size: 0.4em; color: #FE5C17; position: relative; top: -0.6em; line-height: 0; letter-spacing: 0; }
    .ledger-num i { font-style: normal; font-size: 0.34em; color: #FE5C17; letter-spacing: 0.02em; }
    .ledger-num i:first-child { position: relative; top: -0.45em; }
    .ledger-lab { display: block; margin-top: clamp(0.6rem, 1.3vw, 0.9rem); font-size: clamp(0.78rem, 1vw, 0.9rem); line-height: 1.45; color: rgba(255, 255, 255, 0.55); max-width: 24ch; text-wrap: pretty; }
    .ledger-note { margin-top: clamp(1.25rem, 3vw, 1.75rem); font-size: 0.78rem; line-height: 1.65; color: rgba(255, 255, 255, 0.45); max-width: 76ch; }
    .ledger-note b { font-weight: 700; color: rgba(255, 255, 255, 0.75); text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.9em; margin-right: 0.5rem; }

    @media (min-width: 768px) {
      .ledger { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      .ledger-item,
      .ledger-item:nth-child(odd),
      .ledger-item:nth-child(even),
      .ledger-item:nth-child(n+3) {
        padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1.1rem, 2.2vw, 2rem);
        border-bottom: none;
        border-left: 1px solid rgba(255, 255, 255, 0.15);
      }
      .ledger-item:first-child { border-left: none; padding-left: 0; }
      .ledger-item:last-child { border-right: none; padding-right: 0; }
    }

    /* ============ PROCESSO ============ */
    .proc {
      padding: clamp(3.5rem, 8vw, 6.5rem) 0;
      background-color: var(--dia);
      background-image: var(--horizonte), radial-gradient(44rem 22rem at 8% -10%, rgba(254, 92, 23, 0.13), transparent 70%);
      background-size: 100% 2px, auto;
      background-repeat: no-repeat, no-repeat;
      background-position: top left, left top;
    }
    .head-split { max-width: none; display: grid; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: end; }
    @media (min-width: 900px) { .head-split { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); } }
    .head-side p { color: #52525b; font-size: clamp(1rem, 1.3vw, 1.1rem); line-height: 1.75; max-width: 44ch; }
    .head-side .btn { margin-top: clamp(1.25rem, 2.5vw, 1.75rem); }

    .flow-tabs {
      display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: clamp(0.5rem, 1vw, 0.75rem);
    }
    .flow-tab {
      display: flex; align-items: center; gap: clamp(0.5rem, 1vw, 0.85rem);
      min-width: 0; padding: clamp(0.85rem, 1.6vw, 1.1rem) clamp(0.9rem, 1.8vw, 1.35rem);
      background: var(--papel); border: 1px solid var(--fio); border-radius: 0.85rem;
      box-shadow: 0 6px 18px rgba(10, 14, 23, 0.05);
      font: inherit; text-align: left; cursor: pointer; color: #6b7280;
      transition: background-color 0.3s, border-color 0.3s, color 0.3s, box-shadow 0.3s, transform 0.3s;
    }
    .flow-tab:hover { border-color: rgba(254, 92, 23, 0.5); color: #111; transform: translateY(-2px); }
    .flow-tab:focus-visible { outline: 2px solid var(--sol); outline-offset: 3px; }
    .flow-tab[aria-selected='true'] {
      background: var(--painel); border-color: var(--painel); color: #fff;
      box-shadow: 0 16px 34px rgba(10, 14, 23, 0.22); transform: none;
    }
    .flow-tn { flex: none; font-size: 0.72rem; letter-spacing: 0.2em; color: var(--sol-pro); font-weight: 700; }
    .flow-tab[aria-selected='true'] .flow-tn { color: #FE5C17; }
    .flow-tt {
      min-width: 0; font-weight: 700; font-size: clamp(0.98rem, 1.3vw, 1.1rem);
      letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    .flow-stage {
      position: relative; margin-top: clamp(0.75rem, 1.5vw, 1.1rem);
      background: var(--papel); border: 1px solid var(--fio); border-radius: 1rem;
      padding: clamp(1.5rem, 3.5vw, 3rem);
      box-shadow: 0 26px 60px rgba(10, 14, 23, 0.09);
      overflow: hidden;
    }
    .flow-panel { position: relative; }
    .flow-panel::after {
      content: attr(data-n); position: absolute; z-index: 0; pointer-events: none;
      right: clamp(0.75rem, 3vw, 2.5rem); bottom: -2.75rem;
      font-size: clamp(7rem, 17vw, 13rem); font-weight: 800; line-height: 0.78;
      letter-spacing: -0.07em; color: rgba(254, 92, 23, 0.06);
      -webkit-text-stroke: 2px rgba(254, 92, 23, 0.16);
    }
    .flow-top {
      position: relative; z-index: 1;
      display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem;
    }
    .flow-badge {
      flex: none; width: 2.5rem; height: 2.5rem; border-radius: 0.6rem;
      display: grid; place-items: center;
      background: var(--painel); color: #FE5C17;
    }
    .flow-badge svg { width: 1.3rem; height: 1.3rem; }
    .flow-chip {
      display: inline-flex; align-items: center;
      font-family: ui-monospace, "SFMono-Regular", "Menlo", "Consolas", "Liberation Mono", monospace;
      font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--sol-pro); background: rgba(254, 92, 23, 0.08);
      border: 1px solid rgba(254, 92, 23, 0.32); border-radius: 999px;
      padding: 0.45rem 0.85rem;
    }
    .flow-chip::before { content: ''; width: 0.4rem; height: 0.4rem; border-radius: 50%; background: var(--sol); }
    .flow-grid {
      position: relative; z-index: 1; display: grid;
      gap: clamp(1.5rem, 3vw, 2.75rem);
      margin-top: clamp(1.25rem, 3vw, 2.25rem);
    }
    @media (min-width: 900px) { .flow-grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); } }
    .flow-copy h3 {
      font-size: clamp(1.9rem, 4vw, 3rem); font-weight: 700;
      letter-spacing: -0.035em; line-height: 1.03; color: #111;
    }
    .flow-copy p {
      margin-top: 0.9rem; color: #52525b;
      font-size: clamp(1rem, 1.2vw, 1.08rem); line-height: 1.75;
    }
    .flow-points {
      list-style: none; align-self: start; display: grid; gap: 0.85rem;
      padding-left: clamp(1rem, 2vw, 1.5rem);
      border-left: 2px solid rgba(254, 92, 23, 0.35);
    }
    .flow-points li {
      display: flex; align-items: flex-start; gap: 0.7rem;
      font-size: 0.97rem; line-height: 1.6; color: #3f3f46;
    }
    .flow-points li::before {
      content: '\2713'; flex: none; margin-top: 0.15rem;
      width: 1.35rem; height: 1.35rem; display: grid; place-items: center;
      font-size: 0.72rem; font-weight: 700; color: #fff; background: var(--sol); border-radius: 50%;
    }
    @keyframes flowIn { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
    .flow-panel:not([hidden]) { animation: flowIn 0.5s cubic-bezier(0.2, 0.7, 0.3, 1) backwards; }

    @media (max-width: 899px) {
      .flow-tabs { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; }
      .flow-tab {
        flex-direction: column; align-items: flex-start; justify-content: center;
        gap: 0.3rem; min-height: 4.4rem; padding: 0.8rem 0.95rem; border-radius: 0.75rem;
      }
      .flow-tt { font-size: 1rem; white-space: normal; }
      .flow-stage { border-radius: 0.85rem; padding: clamp(1.25rem, 5vw, 1.6rem); }
      .flow-panel::after { font-size: clamp(5.5rem, 30vw, 8rem); bottom: -1.75rem; }
      .flow-copy h3 { font-size: clamp(1.75rem, 8vw, 2.3rem); }
      .flow-points { gap: 0.7rem; }
    }

    /* ============ PROJETOS ============ */
    .work { background: var(--painel); padding: clamp(3.5rem, 8vw, 6.5rem) 0; }
    .cases { display: grid; gap: clamp(2rem, 5vw, 4rem); }
    .case { display: grid; gap: clamp(1.5rem, 3vw, 3rem); align-items: center; }
    @media (min-width: 900px) {
      .case { grid-template-columns: 1.15fr 1fr; }
      .case:nth-child(even) .case-img { order: 2; }
    }
    .case-img { position: relative; border-radius: 1rem; overflow: hidden; background: #141a26; }
    .case-img img { width: 100%; height: 100%; aspect-ratio: 16 / 11; object-fit: cover; display: block; transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.3, 1); }
    .case:hover .case-img img { transform: scale(1.04); }
    .case-type {
      position: absolute; top: 1rem; left: 1rem; font-size: 0.62rem; letter-spacing: 0.18em;
      background: rgba(10, 14, 23, 0.75); backdrop-filter: blur(6px); color: #FE5C17;
      border: 1px solid rgba(255, 255, 255, 0.16); padding: 0.4rem 0.8rem; border-radius: 999px;
    }
    .case-local { font-size: 0.66rem; letter-spacing: 0.18em; text-transform: uppercase; color: #6b7383; }
    .case-body h3 { color: #fff; font-size: clamp(1.6rem, 3.5vw, 2.4rem); font-weight: 700; letter-spacing: -0.035em; margin: 0.7rem 0 0.5rem; }
    .case-econ { color: var(--sol); font-size: clamp(1.6rem, 3.5vw, 2.4rem); font-weight: 700; letter-spacing: -0.04em; margin-bottom: 1.75rem; }
    .case-econ span { font-size: 0.45em; letter-spacing: 0.1em; color: var(--prata); vertical-align: middle; margin: 0 0.15em 0 0.2em; }
    .case-econ span:last-child { margin-left: 0.35em; }
    .spec { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(168, 176, 189, 0.2); margin-bottom: 1.75rem; }
    .spec > div { padding: 1rem 1rem 0 0; border-right: 1px solid rgba(168, 176, 189, 0.14); }
