---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import FaqItem from '../components/FaqItem.astro';

const segments = [
  { cat: 'RESIDENCIAL', title: 'Para sua casa', desc: 'Economize até 95% com um sistema dimensionado para o seu telhado e para o seu consumo real.', href: '/servico-residencial', img: '/cat-casa.webp' },
  { cat: 'COMERCIAL', title: 'Para sua empresa', desc: 'Reduza o custo fixo da operação e proteja a margem contra a tarifa que sobe todo ano.', href: '/servico-comercial', img: '/cat-empresa.webp' },
  { cat: 'USINAS', title: 'Para sua usina solar', desc: 'Geração em escala com monitoramento, operação e manutenção do projeto à entrega da energia.', href: '/usina-solar', img: '/cat-usina.webp' },
  { cat: 'AGRONEGÓCIO', title: 'Para o agro', desc: 'Energia estável para irrigação, câmara fria e armazenagem, inclusive onde a rede oscila.', href: '/agronegocio', img: '/cat-agro.webp' },
  { cat: 'INVESTIDORES', title: 'Para investidores', desc: 'Usinas solares com contrato de longo prazo e gestão profissional de todo o ativo.', href: '/investidores', img: '/cat-investidor.webp' },
  { cat: 'VEÍCULOS', title: 'Para seu carro elétrico', desc: 'Recarregue o carro com a energia que o seu próprio telhado produz de graça.', href: '/carregamento-ev', img: '/cat-ev.webp' },
];

const steps = [
  {
    n: '01', title: 'Consulta', icon: 'chat',
    chip: 'Resposta em até 24 horas',
    desc: 'Você manda a conta de luz e a gente devolve a análise em até 24 horas — sem custo e sem compromisso.',
    points: ['Leitura do consumo real da sua conta', 'Estimativa de geração para o seu telhado', 'Simulação da economia no mês e no ano'],
  },
  {
    n: '02', title: 'Projeto', icon: 'ruler',
    chip: 'Aprovação na concessionária: 30 a 60 dias',
    desc: 'Dimensionamento sob medida para o seu telhado, o seu consumo e a sua concessionária. Cuidamos de toda a documentação para você.',
    points: ['Projeto elétrico sob medida para o seu telhado', 'Lista de materiais e equipamentos', 'Documentação e aprovação por nossa conta'],
  },
  {
    n: '03', title: 'Instalação', icon: 'tool',
    chip: 'Sem licença da prefeitura até 75 kW',
    desc: 'Equipe própria, obra limpa e todo o processo regularizado junto à distribuidora — do primeiro parafuso ao primeiro kWh.',
    points: ['Montagem, cabeamento e testes de segurança', 'Atendimento na sua casa ou empresa', 'Ligações regularizadas na distribuidora'],
  },
  {
    n: '04', title: 'Economia', icon: 'coin',
    chip: 'Payback médio de 4 a 6 anos',
    desc: 'Sistema ligado, monitorado no celular e a conta caindo já no primeiro mês. Você acompanha tudo pelo aplicativo.',
    points: ['Monitoramento pelo celular, a qualquer hora', 'Conta menor já na primeira fatura', 'Sistema com garantia de 25 anos'],
  },
];

const cases = [
  { type: 'RESIDENCIAL', title: 'Sistema 10 kWp', local: 'Curvelo / MG', econ: '420', img: '/proj-residencial.webp', alt: 'Sistema solar residencial de 10 kWp instalado em Curvelo', specs: [['PAINÉIS', '18'], ['POTÊNCIA', '10 kWp'], ['ECONOMIA', 'R$ 420/mês']] },
  { type: 'COMERCIAL', title: 'Sistema 50 kWp', local: 'Curvelo / MG', econ: '8.500', img: '/proj-comercial.webp', alt: 'Sistema solar comercial de 50 kWp em operação', specs: [['PAINÉIS', '90'], ['POTÊNCIA', '50 kWp'], ['ECONOMIA', 'R$ 8.500/mês']] },
  { type: 'RURAL', title: 'Sistema 30 kWp', local: 'Região de Curvelo / MG', econ: '5.200', img: '/proj-rural.webp', alt: 'Sistema solar rural de 30 kWp em propriedade produtiva', specs: [['PAINÉIS', '54'], ['POTÊNCIA', '30 kWp'], ['ECONOMIA', 'R$ 5.200/mês']] },
];

const testimonials = [
  { text: 'Minha conta caiu de R$ 450 para R$ 25. Profissionalismo e qualidade do começo ao fim.', name: 'Carlos Eduardo', loc: 'Curvelo/MG' },
  { text: 'Economia de 80% na propriedade rural. Foi o melhor investimento que fiz nos últimos anos.', name: 'César Bonifácio', loc: 'Curvelo/MG' },
  { text: 'Economia de R$ 400 por mês desde a instalação. Equipe nota 10, sempre pontual.', name: 'Sonia Valgas', loc: 'Curvelo/MG' },
];

const posts = [
  { cat: 'MERCADO', title: 'Energia solar em Minas Gerais', desc: 'Oportunidades e incentivos para quem quer gerar a própria energia no estado.', date: '20 Jul 2026', href: '/blog/energia-solar-curvelo-guia', img: '/hero-solar.webp' },
  { cat: 'EDUCAÇÃO', title: 'Guia completo de energia solar', desc: 'Entenda o sistema fotovoltaico sem jargão técnico, do painel ao inversor.', date: '15 Jul 2026', href: '/blog/energia-solar-guia-completo', img: '/sobre-solar.webp' },
  { cat: 'ECONOMIA', title: 'Erros comuns ao escolher energia solar', desc: 'Os deslizes que fazem o payback dobrar — e como evitar cada um deles.', date: '10 Jul 2026', href: '/blog/erros-comuns-energia-solar', img: '/servico-comercial.webp' },
  { cat: 'MANUTENÇÃO', title: 'Manutenção de sistemas solares', desc: 'Limpeza, inspeção e o calendário simples que faz o sistema durar 25 anos.', date: '05 Jul 2026', href: '/blog/manutencao-energia-solar', img: '/servico-manutencao.webp' },
];
---

<Layout
  title="Cordeiro Energia - Energia Solar em Minas Gerais | Orçamento Grátis"
  description="Especialistas em energia solar fotovoltaica em Curvelo/MG. Reduza sua conta de luz em até 95% com sistema solar profissional. Orçamento gratuito."
>
  <Header />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Quanto custa instalar energia solar?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "O investimento varia conforme o consumo. Para uma residência comum, o custo gira entre R$ 8.000 e R$ 50.000, dependendo do tamanho do sistema. Sistemas de 3 a 6 kWp são ideais para casas. O payback médio é de 4 a 6 anos, e o sistema dura mais de 25 anos."
        }
      },
      {
        "@type": "Question",
        "name": "Quanto vou economizar na conta de luz?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Em média, a economia varia de 40% a 95% na conta de luz. Um sistema bem dimensionado pode gerar economia de R$ 300 a R$ 1.500 mensais, dependendo do consumo e da tarifa da concessionária."
        }
      },
      {
        "@type": "Question",
        "name": "E se ficar nublado ou chover?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Os painéis solares funcionam com luz difusa, ou seja, geram energia mesmo em dias nublados, porém com redução de 10% a 30%. A chuva ainda limpa os painéis naturalmente. O sistema é dimensionado considerando as condições climáticas da sua região."
        }
      },
      {
        "@type": "Question",
        "name": "Preciso de licença da prefeitura?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Para sistemas residenciais de até 75 kW, não é necessária licença da prefeitura. O processo envolve apenas aprovação da concessionária de energia, que leva de 30 a 60 dias. Cuidamos de toda a documentação para você."
        }
      },
      {
        "@type": "Question",
        "name": "O granizo danifica os painéis?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Os painéis modernos possuem certificação IEC 61215 de resistência a granizo. São testados com impacto de granizo de 25 mm de diâmetro a 85 km/h. Em casos extremos, a cobertura do seguro do imóvel geralmente cobre danos."
        }
      },
      {
        "@type": "Question",
        "name": "Como funciona a manutenção?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A manutenção é simples e de baixo custo. Basta limpar os painéis a cada 3 a 6 meses com água e pano macio. A inspeção técnica completa é recomendada uma vez por ano, custando entre R$ 300 e R$ 800."
        }
      }
    ]
  })} />

  <main>
    <!-- Hero -->
    <section class="hero" id="hero">
      <div class="hero-bg">
        <img src="/hero-solar.webp" alt="Painéis solares instalados em residência gerando energia limpa" fetchpriority="high" width="1920" height="1080" />
        <div class="hero-overlay"></div>
      </div>
      <div class="container hero-content">
        <div class="hero-badge">
          <svg style="width:1rem;height:1rem;" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><path d="M12 1v3M12 20v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M1 12h3M20 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
          Energia Solar Fotovoltaica
        </div>
        <h1>Deixe o sol <span>pagar sua conta</span></h1>
        <p>Reduza sua conta de luz em até <strong>95%</strong> com um sistema solar profissional. Sem burocracia, com garantia de 25 anos.</p>
        <div class="hero-btns">
          <a href="#contato" class="btn btn-orange btn-xl">QUERO ECONOMIZAR
            <svg style="width:1rem;height:1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="https://wa.me/5538997350343?text=Ol%C3%A1%2C%20gostaria%20de%20um%20or%C3%A7amento%20para%20energia%20solar" class="btn btn-outline btn-xl" target="_blank" rel="noopener noreferrer">
            <svg style="width:1.1rem;height:1.1rem;" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WHATSAPP
          </a>
        </div>
      </div>
    </section>

    <!-- Simulador -->
    <section class="sim" id="economia">
      <div class="sim-cells" aria-hidden="true"></div>
      <div class="container sim-inner">
        <div class="sim-copy scroll-reveal">
          <span class="eyebrow">Simulador de economia</span>
          <h2>Quanto o sol <span class="hl">devolve</span> pro seu bolso</h2>
          <p class="sim-lead">Arraste o valor da sua conta de luz e veja, em tempo real, quanto sobra por mês com um sistema bem dimensionado para o seu consumo.</p>

          <div class="slider">
            <div class="slider-head">
              <label for="bill">Sua conta atual</label>
              <output id="billOut" for="bill">R$ 450</output>
            </div>
            <input type="range" id="bill" min="100" max="5000" step="10" value="450" aria-describedby="billHelp" />
            <div class="slider-scale" id="billHelp"><span>R$ 100</span><span>R$ 5.000</span></div>
          </div>

          <a href="#contato" class="btn btn-orange btn-xl">QUERO ESSE NÚMERO
            <svg style="width:1rem;height:1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>

        <div class="panel scroll-reveal">
          <div class="panel-top">
            <span class="panel-name">Painel de economia</span>
            <span class="panel-led" aria-hidden="true"></span>
          </div>

          <div class="read">
            <span class="read-label">Conta atual</span>
            <span class="read-val read-mute" id="vAtual">R$ 450</span>
          </div>
          <div class="track"><span class="track-fill" id="barAtual"></span></div>

          <div class="read">
            <span class="read-label">Com energia solar</span>
            <span class="read-val read-sol" id="vNovo">R$ 54</span>
          </div>
          <div class="track track-sol"><span class="track-fill" id="barNovo"></span></div>

          <div class="out">
            <div class="out-cell">
              <span class="read-label">Economia / mês</span>
              <strong id="vMes">R$ 396</strong>
            </div>
            <div class="out-cell">
              <span class="read-label">Economia / ano</span>
              <strong id="vAno">R$ 4.752</strong>
            </div>
            <div class="out-cell">
              <span class="read-label">CO₂ evitado / ano</span>
              <strong id="vCo2">297 kg</strong>
            </div>
          </div>

          <p class="panel-note">Estimativa com tarifa média de R$ 0,70/kWh e substituição de 88% do consumo. Payback médio de 4 a 6 anos, garantia de 25 anos.</p>
        </div>
      </div>
    </section>

    <!-- Segmentos -->
    <section class="segs" id="servicos">
      <div class="container">
        <div class="bento scroll-reveal stagger">
          <div class="bento-intro">
            <span class="eyebrow">Segmentos</span>
            <h2>Onde o sol <span class="hl">trabalha</span></h2>
            <p>Seis frentes de atendimento, a mesma engenharia por trás de cada uma delas.</p>
            <a href="#contato" class="bento-cta">
              Pedir orçamento
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>

          {segments.map((s) => (
            <a href={s.href} class="tile">
              <img class="tile-img" src={s.img} alt="" width="800" height="600" loading="lazy" />
              <span class="tile-scrim" aria-hidden="true"></span>
              <span class="tile-cat">{s.cat}</span>
              <span class="tile-body">
                <span class="tile-title">{s.title}</span>
                <span class="tile-desc">{s.desc}</span>
              </span>
              <span class="tile-go" aria-hidden="true">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Sobre + números -->
    <section class="about" id="sobre">
      <div class="container">
        <div class="about-split">
          <figure class="about-media scroll-reveal">
            <img src="/servico-residencial.webp" alt="Técnico da Cordeiro Energia conectando os cabos de um módulo fotovoltaico no telhado" width="1200" height="675" loading="lazy" />
            <figcaption class="about-pin">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span class="about-pin-t"><b>Curvelo</b>Minas Gerais</span>
            </figcaption>
          </figure>

          <div class="claim scroll-reveal">
            <span class="eyebrow">Quem somos</span>
            <h2>Da visita técnica à primeira economia, a gente faz o caminho <span class="hl">inteiro</span></h2>
            <p class="claim-lead">A <strong>Cordeiro Energia</strong> é uma equipe de Curvelo/MG que projeta, instala e acompanha sistemas fotovoltaicos para casas, empresas, sítios e usinas. Você manda a conta de luz, a gente devolve o projeto — e continua por perto depois que o sistema liga.</p>
            <div class="claim-actions">
              <a href="#contato" class="btn btn-orange btn-xl">Falar com um especialista
                <svg style="width:1rem;height:1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
              <a href="https://wa.me/5538997350343" class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
                <svg style="width:1.05rem;height:1.05rem;" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="ledger-band">
        <div class="container">
          <div class="ledger scroll-reveal stagger" role="group" aria-label="Resultados da Cordeiro Energia">
            <div class="ledger-item">
              <span class="ledger-num"><span class="num-val" data-target="500">500</span><sup>+</sup></span>
              <span class="ledger-lab">Projetos instalados</span>
            </div>
            <div class="ledger-item">
              <span class="ledger-num"><span class="num-val" data-target="150">150</span><sup>+</sup></span>
              <span class="ledger-lab">Residências atendidas</span>
            </div>
            <div class="ledger-item">
              <span class="ledger-num"><i>R$</i><span class="num-val" data-target="5">5</span><i>mi</i></span>
              <span class="ledger-lab">Economizados por nossos clientes</span>
            </div>
            <div class="ledger-item">
              <span class="ledger-num"><span class="num-val" data-target="1000">1.000</span><i>t</i></span>
              <span class="ledger-lab">de CO₂ evitado</span>
            </div>
          </div>

          <p class="ledger-note scroll-reveal"><b>Notas:</b> Números consolidados dos sistemas que instalamos e acompanhamos. A emissão de CO₂ é estimada pela média da matriz elétrica nacional.</p>
        </div>
      </div>
    </section>

    <!-- Processo -->
    <section class="proc">
      <div class="container">
        <header class="head head-split scroll-reveal">
          <div class="head-main">
            <span class="eyebrow">Processo</span>
            <h2>Do primeiro zap à <span class="hl">economia</span></h2>
          </div>
          <div class="head-side">
            <p>Quatro etapas, sem letra miúda e sem custo nenhum até você aprovar o projeto.</p>
            <a href="#contato" class="btn btn-orange btn-xl">Começar agora
              <svg style="width:1rem;height:1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </header>

        <div class="flow scroll-reveal stagger" data-flow>
          <div class="flow-tabs" role="tablist" aria-label="Etapas do processo">
            {steps.map((s, i) => (
              <button
                class="flow-tab"
                type="button"
                role="tab"
                id={`flow-t${i}`}
                aria-controls={`flow-p${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                <span class="flow-tn">{s.n}</span>
                <span class="flow-tt">{s.title}</span>
              </button>
            ))}
          </div>
          <div class="flow-stage">
            {steps.map((s, i) => (
              <div
                class="flow-panel"
                id={`flow-p${i}`}
                role="tabpanel"
                aria-labelledby={`flow-t${i}`}
                tabindex="0"
                data-n={s.n}
                hidden={i !== 0}
              >
                <div class="flow-top">
                  <span class="flow-badge" aria-hidden="true">
                    {s.icon === 'chat' && <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h8m-8 4h5M21 12a8 8 0 01-8 8H7l-4 3v-5.5A8 8 0 1121 12z" /></svg>}
