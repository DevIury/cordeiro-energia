          </div>
          <div class="card benefit-card" style="padding:2rem;">
            <div class="benefit-icon" style="width:3.5rem;height:3.5rem;border-radius:50%;background:linear-gradient(135deg,#FE5C17,#FF8F00);display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem;">
