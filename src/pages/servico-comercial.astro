---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
import FaqItem from '../components/FaqItem.astro';
---

<Layout
  title="Energia Solar Comercial - Cordeiro Energia | Para Empresas e Comércios"
  description="Soluções de energia solar para empresas e comércios. Reduza custos operacionais com energia limpa. ROI em 3-5 anos. Orçamento gratuito."
>
  <Header />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Posso deduzir o ICMS?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sim! A energia gerada pode ser utilizada para compensar o ICMS da sua conta, resultando em economia adicional significativa para a sua empresa."
        }
      },
      {
        "@type": "Question",
        "name": "E se minha empresa não consumir toda a energia?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "O excedente é injetado na rede e compensado na sua conta de luz, gerando créditos energéticos que podem ser utilizados em até 60 meses."
        }
      },
      {
        "@type": "Question",
        "name": "Qual o tempo de instalação?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sistemas comerciais de médio porte são instalados em 5 a 15 dias, dependendo da complexidade do projeto e da necessidade de aprovações."
        }
      },
      {
        "@type": "Question",
        "name": "É necessário autorização da prefeitura?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sim, para sistemas maiores é necessária aprovação da prefeitura e da concessionária de energia. Cuidamos de todo o processo burocrático para você."
        }
      }
    ]
  })} />

  <main>
    <!-- Hero -->
    <section style="position:relative;min-height:70vh;display:flex;align-items:center;overflow:hidden;">
      <img src="/cat-empresa.webp" alt="Energia solar comercial" fetchpriority="high" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
      <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(0,0,0,0.85) 0%,rgba(0,0,0,0.6) 40%,rgba(254,92,23,0.4) 100%);"></div>
      <div style="position:relative;z-index:1;width:100%;max-width:1200px;margin:0 auto;padding:0 1.5rem;">
        <div style="display:inline-flex;align-items:center;gap:0.5rem;background:rgba(254,92,23,0.15);border:1px solid rgba(254,92,23,0.3);border-radius:9999px;padding:0.5rem 1.25rem;color:#FE5C17;font-size:0.8rem;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;margin-bottom:1.5rem;">
          <svg style="width:1rem;height:1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          Solução Comercial
        </div>
        <h1 style="font-size:3rem;font-weight:800;color:#fff;line-height:1.1;margin-bottom:1rem;">Energia Solar<br/><span style="color:#FE5C17;">para Empresas</span></h1>
        <p style="font-size:1.15rem;color:rgba(255,255,255,0.85);max-width:560px;line-height:1.7;margin-bottom:2.5rem;">Reduza custos operacionais e aumente a competitividade da sua empresa com energia solar limpa e renovável.</p>
        <div style="display:flex;flex-wrap:wrap;gap:1rem;">
          <a href="https://wa.me/5538997350343?text=Ol%C3%A1%2C%20gostaria%20de%20um%20or%C3%A7amento%20comercial" target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:0.5rem;background:#25D366;color:#fff;font-weight:700;font-size:0.95rem;padding:1rem 2rem;border-radius:12px;text-decoration:none;transition:transform 0.2s,box-shadow 0.2s;">
            <svg style="width:1.25rem;height:1.25rem;" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            SOLICITAR PROPOSTA
          </a>
          <a href="#beneficios" style="display:inline-flex;align-items:center;gap:0.5rem;background:transparent;border:2px solid rgba(255,255,255,0.4);color:#fff;font-weight:700;font-size:0.95rem;padding:1rem 2rem;border-radius:12px;text-decoration:none;transition:background 0.2s,border-color 0.2s;">
