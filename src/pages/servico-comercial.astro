        </div>
      </div>
    </section>

    <!-- Stats Bar -->
    <section style="padding:3.5rem 0;background:#f9fafb;border-bottom:1px solid #e5e7eb;">
      <div style="max-width:1200px;margin:0 auto;padding:0 1.5rem;">
        <div class="stats-bar" style="gap:2rem;text-align:center;">
          <div>
            <div style="font-size:2.5rem;font-weight:800;color:#FE5C17;line-height:1;">R$ 50K+</div>
            <div style="color:#6b7280;font-size:0.85rem;margin-top:0.5rem;">Economia mensal em média</div>
          </div>
          <div>
            <div style="font-size:2.5rem;font-weight:800;color:#FE5C17;line-height:1;">3-5 anos</div>
            <div style="color:#6b7280;font-size:0.85rem;margin-top:0.5rem;">Payback do investimento</div>
          </div>
          <div>
            <div style="font-size:2.5rem;font-weight:800;color:#FE5C17;line-height:1;">25 anos</div>
            <div style="color:#6b7280;font-size:0.85rem;margin-top:0.5rem;">Garantia dos equipamentos</div>
          </div>
          <div>
            <div style="font-size:2.5rem;font-weight:800;color:#FE5C17;line-height:1;">100%</div>
            <div style="color:#6b7280;font-size:0.85rem;margin-top:0.5rem;">Incentivos fiscais</div>
