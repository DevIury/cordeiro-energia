---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
---

<Layout
  title="Página não encontrada - Cordeiro Energia"
  description="A página que você procura não existe ou foi movida."
>
  <Header />

  <main>
    <section style="min-height:70vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:6rem 1.5rem;">
      <div>
        <div style="font-size:6rem;font-weight:900;color:#FE5C17;line-height:1;margin-bottom:1rem;">404</div>
        <h1 style="font-size:1.75rem;font-weight:700;color:#111;margin-bottom:1rem;">Página não encontrada</h1>
        <p style="color:#6b7280;font-size:1rem;max-width:400px;margin:0 auto 2rem;line-height:1.6;">
          O link que você acessou não existe ou foi movido para outro endereço.
        </p>
        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
          <a href="/" class="btn btn-orange" style="padding:0.875rem 2rem;font-weight:700;border-radius:0.625rem;text-decoration:none;">
            Voltar ao Início
          </a>
          <a href="/blog" class="btn btn-outline" style="padding:0.875rem 2rem;font-weight:700;border-radius:0.625rem;text-decoration:none;border:1.5px solid #e5e7eb;color:#374151;">
            Ver Blog
          </a>
        </div>
      </div>
    </section>
  </main>

  <FloatingWhatsApp />
  <Footer />
</Layout>
