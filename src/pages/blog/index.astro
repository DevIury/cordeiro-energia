---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import CtaSection from '../../components/CtaSection.astro';
import Analytics from '../../components/Analytics.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts[0];
const rest = posts.slice(1);

const tagColors: Record<string, string> = {
  'energia solar': '#FE5C17',
  'economia': '#00C853',
  'guia completo': '#2196F3',
  'fotovoltaico': '#FF9800',
  'manutenção': '#9C27B0',
  'curvelo': '#FE5C17',
  'dicas': '#00BCD4',
  'instalação': '#FF5722',
  'erros': '#E53935',
  'conta de luz': '#FF9800',
  'simulação': '#3F51B5',
  'residencial': '#00897B',
  'comercial': '#5E35B1',
  'inversor': '#F57C00',
  'bandeira tarifária': '#C62828',
  'tarifa': '#C62828',
  'clima': '#1565C0',
  'granizo': '#1565C0',
  'durabilidade': '#2E7D32',
  'segurança': '#D32F2F',
  'financiamento': '#6A1B9A',
  'crédito': '#6A1B9A',
  'investimento': '#1B5E20',
  'guia municipal': '#4E342E',
  'minas gerais': '#4E342E',
};

function getTagColor(tag: string): string {
  return tagColors[tag] || '#6b7280';
}

const blogCovers = [
  `linear-gradient(135deg, #FFF5ED 0%, #FFE0CC 100%)`,
  `linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%)`,
  `linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%)`,
  `linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%)`,
  `linear-gradient(135deg, #F3E5F5 0%, #E1BEE7 100%)`,
  `linear-gradient(135deg, #E0F7FA 0%, #B2EBF2 100%)`,
  `linear-gradient(135deg, #FBE9E7 0%, #FFCCBC 100%)`,
  `linear-gradient(135deg, #F1F8E9 0%, #DCEDC8 100%)`,
  `linear-gradient(135deg, #EDE7F6 0%, #D1C4E9 100%)`,
  `linear-gradient(135deg, #FFF8E1 0%, #FFECB3 100%)`,
];

const blogIcons = [
  `<svg width="2.5rem" height="2.5rem" viewBox="0 0 24 24" fill="none" stroke="#FE5C17" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/></svg>`,
  `<svg width="2.5rem" height="2.5rem" viewBox="0 0 24 24" fill="none" stroke="#FE5C17" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>`,
  `<svg width="2.5rem" height="2.5rem" viewBox="0 0 24 24" fill="none" stroke="#FE5C17" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.1-5.1m5.1 5.1L12 21m-0.58-5.83l5.1-5.1M12 3v3m6.36 1.64l-2.12 2.12M21 12h-3M4.22 12H1.26m17.48 5.14l-2.12-2.12M12 21v-3m-1.64-6.36L8.24 9.52"/></svg>`,
  `<svg width="2.5rem" height="2.5rem" viewBox="0 0 24 24" fill="none" stroke="#FE5C17" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"/></svg>`,
  `<svg width="2.5rem" height="2.5rem" viewBox="0 0 24 24" fill="none" stroke="#FE5C17" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"/></svg>`,
];

function formatDate(date: Date): string {
  return date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
}
---

<Layout
  title="Blog - Cordeiro Energia | Dicas sobre Energia Solar"
  description="Artigos e dicas sobre energia solar, economia na conta de luz e sustentabilidade. Mantenha-se informado com a Cordeiro Energia."
>
  <Header />

  <main>
    <!-- Hero -->
    <section style="padding:3.5rem 0 2.5rem;background:linear-gradient(180deg,#FFF5ED 0%,#ffffff 100%);text-align:center;">
      <div class="container" style="max-width:700px;">
        <span style="display:inline-flex;align-items:center;gap:0.4rem;font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#FE5C17;background:rgba(254,92,23,0.08);border:1px solid rgba(254,92,23,0.2);padding:0.5rem 1rem;border-radius:9999px;margin-bottom:1.25rem;">
          <svg style="width:0.75rem;height:0.75rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/></svg>
          Blog
        </span>
        <h1 style="font-size:2.25rem;font-weight:800;color:#111;line-height:1.15;margin-bottom:0.75rem;letter-spacing:-0.02em;">
          Fique por dentro da <span style="color:#FE5C17;">energia solar</span>
        </h1>
        <p style="font-size:1rem;color:#6b7280;line-height:1.7;">
          Artigos, dicas e novidades sobre energia solar, economia e sustentabilidade.
        </p>
      </div>
    </section>

    <!-- Featured post -->
    {featured && (
      <section style="padding:0 0 2rem;">
        <div class="container">
          <a href={`/blog/${featured.id.replace(/\.md$/, '')}`} class="blog-featured scroll-reveal" style="text-decoration:none;">
            <div class="blog-featured-cover" style={`background:${blogCovers[0]};`}>
              {featured.data.image ? (
                <img src={featured.data.image} alt={featured.data.title} style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0;" loading="lazy" />
              ) : (
                <div style="position:relative;z-index:1;opacity:0.5;" set:html={blogIcons[0]} />
              )}
              <div class="blog-featured-badge">Destaque</div>
            </div>
            <div class="blog-featured-body">
              <div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-bottom:0.75rem;">
                {featured.data.tags.slice(0, 3).map((tag) => (
                  <span style={`font-size:0.65rem;font-weight:600;padding:0.25rem 0.6rem;border-radius:9999px;background:${getTagColor(tag)}12;color:${getTagColor(tag)};`}>
                    {tag}
                  </span>
                ))}
              </div>
              <h2 style="font-size:1.5rem;font-weight:800;color:#111;line-height:1.25;margin-bottom:0.75rem;">
                {featured.data.title}
              </h2>
              <p style="font-size:0.9rem;color:#6b7280;line-height:1.7;margin-bottom:1.25rem;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">
                {featured.data.description}
              </p>
              <div style="display:flex;align-items:center;justify-content:space-between;">
                <time style="font-size:0.75rem;color:#9ca3af;" datetime={featured.data.pubDate.toISOString()}>
                  {formatDate(featured.data.pubDate)}
                </time>
                <span style="font-size:0.8rem;font-weight:700;color:#FE5C17;display:inline-flex;align-items:center;gap:0.35rem;">
                  Ler artigo
                  <svg style="width:0.875rem;height:0.875rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        </div>
      </section>
    )}

    <!-- Posts grid -->
    <section style="padding:0 0 4rem;">
      <div class="container">
        <div class="blog-grid">
          {rest.map((post, i) => (
            <a
              href={`/blog/${post.id.replace(/\.md$/, '')}`}
              class="blog-card-item scroll-reveal"
              style={`transition-delay: ${i * 60}ms;`}
            >
              <div class="blog-card-cover" style={`background:${blogCovers[(i + 1) % blogCovers.length]};`}>
                {post.data.image ? (
                  <img src={post.data.image} alt={post.data.title} style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0;" loading="lazy" />
                ) : (
                  <div style="opacity:0.5;" set:html={blogIcons[(i + 1) % blogIcons.length]} />
                )}
              </div>
              <div class="blog-card-body">
                <div style="display:flex;flex-wrap:wrap;gap:0.35rem;margin-bottom:0.5rem;">
                  {post.data.tags.slice(0, 2).map((tag) => (
                    <span style={`font-size:0.6rem;font-weight:600;padding:0.2rem 0.5rem;border-radius:9999px;background:${getTagColor(tag)}12;color:${getTagColor(tag)};`}>
                      {tag}
                    </span>
                  ))}
                </div>
                <h3 style="font-size:0.95rem;font-weight:700;color:#111;line-height:1.35;margin-bottom:0.4rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                  {post.data.title}
                </h3>
                <p style="font-size:0.8rem;color:#6b7280;line-height:1.55;margin-bottom:0.75rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                  {post.data.description}
                </p>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-top:auto;">
                  <time style="font-size:0.7rem;color:#9ca3af;" datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                  <span style="font-size:0.75rem;font-weight:600;color:#FE5C17;display:inline-flex;align-items:center;gap:0.25rem;">
                    Ler
                    <svg style="width:0.75rem;height:0.75rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <CtaSection />
  </main>

  <FloatingWhatsApp />
  <Footer />
  <Analytics />
</Layout>

<style>
  /* Blog grid — mobile first */
  .blog-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 540px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .blog-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1200px) { .blog-grid { grid-template-columns: repeat(4, 1fr); } }

  /* Featured post */
  .blog-featured {
    display: grid;
    grid-template-columns: 1fr;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid #f0f0f0;
    transition: all 0.3s cubic-bezier(0.22,0.61,0.36,1);
  }
  @media (min-width: 768px) {
    .blog-featured { grid-template-columns: 1.2fr 1fr; }
  }
  .blog-featured:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 48px rgba(0,0,0,0.08);
    border-color: rgba(254,92,23,0.15);
  }
  .blog-featured:hover h2 { color: #FE5C17 !important; }
  .blog-featured-cover {
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  @media (min-width: 768px) {
    .blog-featured-cover { min-height: 280px; }
  }
  .blog-featured-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: #FE5C17;
    color: #fff;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
  }
  .blog-featured-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Blog cards */
  .blog-card-item {
    display: flex;
    flex-direction: column;
    border-radius: 0.875rem;
    border: 1px solid #f3f4f6;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.22,0.61,0.36,1);
    text-decoration: none;
  }
  .blog-card-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.07);
    border-color: rgba(254,92,23,0.15);
  }
  .blog-card-item:hover h3 { color: #FE5C17 !important; }
  .blog-card-cover {
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    background-size: cover;
    background-position: center;
  }
  @media (min-width: 900px) {
    .blog-card-cover { height: 130px; }
  }
  .blog-card-body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    background: #fff;
  }
</style>
