---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CtaSection from '../../components/CtaSection.astro';
import { getCollection } from 'astro:content';

const norm = (s = '') =>
  s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

const wordCount = (s = '') => (s.trim() ? s.trim().split(/\s+/).length : 0);
const readMin = (body = '') => Math.max(1, Math.round(wordCount(body) / 200));

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const slugOf = (post) => post.id.replace(/\.md$/, '');

const featured = posts[0];
const rest = posts.slice(1);

const allTags = [...new Set(posts.flatMap(p => p.data.tags))].sort((a, b) =>
  a.localeCompare(b, 'pt-BR')
);

const totalMinutes = posts.reduce((sum, p) => sum + readMin(p.body), 0);
const readingLabel =
  totalMinutes >= 60
    ? `${Math.floor(totalMinutes / 60)}h${totalMinutes % 60 ? ` ${totalMinutes % 60}min` : ''}`
    : `${totalMinutes} min`;

const tagColors: Record<string, string> = {
  'energia solar': '#FE5C17',
  'economia': '#00C853',
  'guia completo': '#2196F3',
  'fotovoltaico': '#FF9800',
  'manutenção': '#9C27B0',
  'curvelo': '#FE5C17',
  'dicas': '#00BCD4',
  'instalação': '#FF5722',
  'erros': '#E53935',
  'conta de luz': '#FF9800',
  'simulação': '#3F51B5',
  'residencial': '#00897B',
  'comercial': '#5E35B1',
  'inversor': '#F57C00',
  'bandeira tarifária': '#C62828',
  'tarifa': '#C62828',
  'clima': '#1565C0',
  'granizo': '#1565C0',
  'durabilidade': '#2E7D32',
  'segurança': '#D32F2F',
  'financiamento': '#6A1B9A',
  'crédito': '#6A1B9A',
  'investimento': '#1B5E20',
  'guia municipal': '#4E342E',
  'minas gerais': '#4E342E',
  'condomínio': '#5E35B1',
  'iptu': '#4E342E',
  'imóvel': '#00897B',
  'contrato': '#6A1B9A',
  'cuidados': '#2E7D32',
  'componentes': '#F57C00',
  'comparativo': '#3F51B5',
};

function getTagColor(tag: string): string {
  return tagColors[tag] || '#9ca3af';
}

function formatDate(date: Date): string {
  return date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
}

const searchIndex = (p: (typeof posts)[number]) =>
  norm([p.data.title, p.data.description, p.data.tags.join(' ')].join(' '));

const stats = [
  { n: String(posts.length), l: 'artigos' },
  { n: readingLabel, l: 'de leitura' },
  { n: String(allTags.length), l: 'temas' },
];
---

<Layout
  title="Blog - Cordeiro Energia | Dicas sobre Energia Solar"
  description="Artigos e dicas sobre energia solar, economia na conta de luz e sustentabilidade. Mantenha-se informado com a Cordeiro Energia."
>
  <Header />

  <main>
    <!-- Masthead -->
    <section class="masthead">
      <div class="container">
        <div class="masthead-copy">
        <p class="eyebrow">Blog · Cordeiro Energia</p>
        <h1>Guias, custos e economia de <span>energia solar</span></h1>
        <p class="lede">
          Artigos práticos sobre instalação, tarifas, financiamento e manutenção —
          para decidir com segurança.
        </p>
        <dl class="stats">
          {stats.map(s => (
            <div class="stat">
              <dt class="stat-n">{s.n}</dt>
              <dd class="stat-l">{s.l}</dd>
            </div>
          ))}
        </dl>
        </div>
      </div>
    </section>

    <!-- Sticky search + filters -->
    <div class="rail" id="rail">
      <div class="container rail-inner">
        <label class="search" for="searchInput">
          <svg aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
          </svg>
          <input type="search" id="searchInput" placeholder="Buscar artigos…" autocomplete="off" aria-label="Buscar artigos" />
        </label>

        <div class="chips" id="tagFilter" role="group" aria-label="Filtrar por tema">
          <button type="button" class="chip is-active" data-tag="all" aria-pressed="true">Todos</button>
          {allTags.map(tag => (
            <button type="button" class="chip" data-tag={tag} aria-pressed="false">{tag}</button>
          ))}
        </div>

        <p class="rail-count" id="railCount" aria-live="polite" aria-atomic="true">
          <strong>{posts.length}</strong> artigos
        </p>
      </div>
    </div>

    {featured && (
      <section class="wrap container featured-wrap" aria-label="Artigo em destaque">
        <a class="feat" href={`/blog/${slugOf(featured)}`} data-tags={featured.data.tags.join(',')} data-search={searchIndex(featured)}>
          <span class="feat-media">
            {featured.data.image && (
              <img
                src={featured.data.image}
                alt={featured.data.title}
                width="800"
                height="500"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            )}
          </span>
          <span class="feat-body">
            <span class="kicker">Destaque · {readMin(featured.body)} min</span>
            <h2 class="feat-title">{featured.data.title}</h2>
            <span class="feat-desc">{featured.data.description}</span>
            <span class="feat-tags">
              {featured.data.tags.slice(0, 3).map(tag => (
                <span class="tag" style={`--tc:${getTagColor(tag)}`}>{tag}</span>
              ))}
            </span>
            <span class="feat-cta">
              Ler artigo
              <svg aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </span>
        </a>
      </section>
    )}

    <!-- Grid -->
    <section class="wrap container grid-wrap" aria-labelledby="gridTitle">
      <div class="sec-head">
        <h2 id="gridTitle">Todos os artigos</h2>
        <span class="rule" aria-hidden="true"></span>
      </div>

      <div class="grid" id="postGrid">
        {rest.map((post, i) => (
          <article
            class="card scroll-reveal"
            style={`transition-delay:${Math.min(i, 7) * 60}ms`}
            data-tags={post.data.tags.join(',')}
            data-search={searchIndex(post)}
          >
            <a href={`/blog/${slugOf(post)}`} class="card-link">
              <span class="card-media">
                {post.data.image && (
                  <img
                    src={post.data.image}
                    alt={post.data.title}
                    width="800"
                    height="500"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </span>
              <span class="card-body">
                <span class="card-tags">
                  {post.data.tags.slice(0, 2).map(tag => (
                    <span class="tag" style={`--tc:${getTagColor(tag)}`}>{tag}</span>
                  ))}
                </span>
                <h3 class="card-title">{post.data.title}</h3>
                <span class="card-desc">{post.data.description}</span>
                <span class="card-foot">
                  <span class="meta">
                    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                    <i aria-hidden="true">·</i>
                    <span>{readMin(post.body)} min</span>
                  </span>
                  <span class="card-arrow" aria-hidden="true">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </span>
                </span>
              </span>
            </a>
          </article>
        ))}
      </div>

      <div class="empty" id="emptyState" role="status" hidden>
        <p>Nenhum artigo encontrado para <strong id="emptyQuery"></strong>.</p>
        <button type="button" class="reset" id="resetFilters">Limpar busca e filtros</button>
      </div>
    </section>

    <CtaSection />
  </main>

  <Footer />
</Layout>

<style>
  main { background: #fafafa; }

  /* ---------- masthead ---------- */
  .masthead {
    position: relative; overflow: hidden;
    padding: clamp(3.5rem, 7vw, 5.5rem) 0 clamp(2.5rem, 5vw, 3.5rem);
    background: linear-gradient(180deg, #fff6f1 0%, #fafafa 82%);
    border-bottom: 1px solid #f0f2f6;
  }
  .masthead::after {
    content: ''; position: absolute; top: -170px; right: -150px;
    width: 480px; height: 480px; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, rgba(254, 92, 23, 0.13), transparent 65%);
  }
  .masthead-copy { position: relative; max-width: 820px; }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 0.6rem;
    margin: 0 0 1.1rem;
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.66rem; letter-spacing: 0.22em; text-transform: uppercase; color: #9ca3af;
  }
  .eyebrow::before {
    content: ''; width: 0.5rem; height: 0.5rem; border-radius: 1px;
    background: linear-gradient(135deg, #FE5C17, #FFC107); transform: rotate(45deg);
  }
  .masthead h1 {
    margin: 0 0 0.9rem; font-size: clamp(2rem, 5vw, 3.4rem); font-weight: 800;
    color: #0A0E17; letter-spacing: -0.04em; line-height: 1.05; text-wrap: balance;
  }
  .masthead h1 span { color: #FE5C17; }
  .lede { margin: 0; max-width: 56ch; color: #6b7280; font-size: clamp(0.97rem, 1.4vw, 1.08rem); line-height: 1.7; }
  .stats {
    display: flex; flex-wrap: wrap; gap: 1.25rem 2rem;
    margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0; padding-top: 1.5rem;
    border-top: 1px solid #eceff4;
  }
  .stat { min-width: 0; }
  .stat + .stat { border-left: 1px solid #eceff4; padding-left: 2rem; }
  .stat-n {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: clamp(1.2rem, 2.4vw, 1.6rem); font-weight: 700; color: #0A0E17; line-height: 1.1;
  }
  .stat-l { margin: 0.25rem 0 0; color: #9ca3af; font-size: 0.74rem; }

  /* ---------- rail ---------- */
  .rail {
    position: sticky; top: var(--nav-h, 76px); z-index: 30;
    background: rgba(255, 255, 255, 0.9);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    border-bottom: 1px solid #f0f2f6;
    box-shadow: 0 12px 26px rgba(10, 14, 23, 0.04);
  }
  .rail-inner {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.65rem 1.25rem;
    padding-top: 0.7rem; padding-bottom: 0.7rem;
  }
  .search {
    order: 1; flex: 1 1 100%;
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.9rem; border-radius: 999px; background: #f4f5f7;
    transition: background-color 0.2s, box-shadow 0.2s;
  }
  .search:focus-within { background: #fff; box-shadow: 0 0 0 2px rgba(254, 92, 23, 0.35); }
  .search svg { width: 0.95rem; height: 0.95rem; color: #9ca3af; flex-shrink: 0; }
  .search input {
    border: 0; outline: 0; background: transparent; width: 100%;
    font: inherit; font-size: 0.875rem; color: #0A0E17;
  }
  .search input::placeholder { color: #9ca3af; }
  .search input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .chips {
    order: 2; flex: 1 1 0; min-width: 0;
    display: flex; gap: 1.15rem; overflow-x: auto; scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .chips::-webkit-scrollbar { display: none; }
  .chip {
    flex-shrink: 0; white-space: nowrap; cursor: pointer;
    padding: 0.35rem 0; border: 0; border-bottom: 2px solid transparent;
    background: none; color: #6b7280; font-size: 0.82rem; font-weight: 500;
    transition: color 0.2s, border-color 0.2s;
  }
  .chip:hover { color: #0A0E17; }
  .chip.is-active { color: #0A0E17; font-weight: 700; border-bottom-color: #FE5C17; }
  .rail-count {
    order: 3; display: none; margin: 0; margin-left: auto;
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: #9ca3af;
    white-space: nowrap;
  }
  .rail-count strong { color: #FE5C17; }
  @media (min-width: 900px) {
    .search { order: 0; flex: 0 0 230px; }
    .rail-count { order: 0; display: block; }
  }

  /* ---------- shared ---------- */
  .wrap { padding-top: clamp(2rem, 4vw, 3rem); }
  .featured-wrap[hidden] { display: none; }
  .kicker {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: #9ca3af;
  }
  .tag {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-size: 0.63rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--tc);
  }
  .tag::before { content: ''; width: 0.35rem; height: 0.35rem; border-radius: 99px; background: currentColor; }

  /* ---------- featured ---------- */
  .feat {
    position: relative;
    display: grid; grid-template-columns: 1fr; text-decoration: none;
    background: #fff; border: 1px solid #eceff4; border-radius: 1.25rem; overflow: hidden;
    transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
  }
  .feat::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; z-index: 2;
    background: linear-gradient(90deg, #FE5C17, #FFC107);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .feat:hover {
    border-color: #e7ebf1; transform: translateY(-4px);
    box-shadow: 0 26px 52px rgba(10, 14, 23, 0.09);
  }
  .feat:hover::before { transform: scaleX(1); }
  @media (min-width: 860px) {
    .feat { grid-template-columns: 1.05fr 1fr; }
  }
  .feat-media { position: relative; overflow: hidden; aspect-ratio: 16 / 10; background: #f4f5f7; }
  .feat-media::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(10, 14, 23, 0) 55%, rgba(10, 14, 23, 0.14));
  }
  .feat-media img {
    display: block; width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .feat:hover .feat-media img { transform: scale(1.03); }
  .feat-body {
    display: flex; flex-direction: column; justify-content: center; gap: 0.85rem;
    padding: clamp(1.5rem, 3vw, 2.6rem);
    background: linear-gradient(180deg, #ffffff 0%, #fffdfb 100%);
  }
  .feat-title {
    margin: 0; font-size: clamp(1.3rem, 2.4vw, 1.9rem); font-weight: 800; color: #0A0E17;
    letter-spacing: -0.03em; line-height: 1.18; text-wrap: balance; transition: color 0.25s;
  }
  .feat:hover .feat-title { color: #FE5C17; }
  .feat-desc {
    color: #6b7280; font-size: 0.94rem; line-height: 1.7;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .feat-tags { display: flex; flex-wrap: wrap; gap: 0.9rem; }
  .feat-cta {
    position: relative;
    display: inline-flex; align-items: center; gap: 0.45rem; align-self: flex-start;
    margin-top: 0.35rem; padding-bottom: 0.3rem;
    color: #0A0E17; font-size: 0.8rem; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; transition: color 0.2s;
  }
  .feat-cta::after {
    content: ''; position: absolute; left: 0; bottom: 0; width: 100%; height: 1.5px;
    background: #0A0E17; transform: scaleX(0.25); transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1), background-color 0.25s;
  }
  .feat-cta svg { width: 0.95rem; height: 0.95rem; transition: transform 0.25s; }
  .feat:hover .feat-cta { color: #FE5C17; }
  .feat:hover .feat-cta::after { transform: scaleX(1); background: #FE5C17; }
  .feat:hover .feat-cta svg { transform: translateX(4px); }

  /* ---------- section head ---------- */
  .sec-head { display: flex; align-items: center; gap: 1.25rem; margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem); }
  .sec-head h2 {
    margin: 0; font-size: clamp(1.05rem, 1.8vw, 1.25rem); font-weight: 800; color: #0A0E17;
    letter-spacing: -0.02em; white-space: nowrap;
  }
  .rule { flex: 1; height: 1px; background: linear-gradient(90deg, rgba(254, 92, 23, 0.5), #eceff4 140px, #eceff4); }
  .grid-wrap { padding-top: clamp(2.75rem, 5vw, 4rem); padding-bottom: clamp(2.5rem, 5vw, 4rem); }

  /* ---------- grid ---------- */
  .grid { display: grid; gap: clamp(1.1rem, 2vw, 1.5rem); grid-template-columns: 1fr; }
  @media (min-width: 600px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 980px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .card[hidden] { display: none; }
  .card {
    position: relative;
    display: flex; background: #fff; border: 1px solid #eceff4; border-radius: 1.2rem;
    overflow: hidden;
    transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
  }
  .card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; z-index: 2;
    background: linear-gradient(90deg, #FE5C17, #FFC107);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .card:hover {
    border-color: #e7ebf1; transform: translateY(-5px);
    box-shadow: 0 22px 44px rgba(10, 14, 23, 0.08);
  }
  .card:hover::before { transform: scaleX(1); }
  .card-link { display: flex; flex-direction: column; flex: 1; min-width: 0; text-decoration: none; }
  .card-media { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: #f4f5f7; }
  .card-media::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(10, 14, 23, 0) 58%, rgba(10, 14, 23, 0.16));
  }
  .card-media img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .card:hover .card-media img { transform: scale(1.04); }
  .card-body { display: flex; flex-direction: column; flex: 1; gap: 0.6rem; padding: 1.1rem 1.15rem 1.05rem; }
  .card-tags { display: flex; flex-wrap: wrap; gap: 0.85rem; }
  .card-title {
    margin: 0; font-size: 1rem; font-weight: 700; color: #0A0E17; line-height: 1.35;
    letter-spacing: -0.015em; text-wrap: pretty; transition: color 0.25s;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .card:hover .card-title { color: #FE5C17; }
  .card-desc {
    color: #6b7280; font-size: 0.85rem; line-height: 1.6;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .card-foot {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    margin-top: auto; padding-top: 0.8rem; border-top: 1px solid #f1f3f7;
  }
  .meta {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.65rem; letter-spacing: 0.08em; text-transform: uppercase; color: #9ca3af;
  }
  .meta i { font-style: normal; color: #d1d5db; }
  .card-arrow {
    display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
    width: 1.9rem; height: 1.9rem; border-radius: 50%;
    background: #f4f5f7; color: #6b7280;
    transition: background-color 0.25s, color 0.25s, transform 0.25s;
  }
  .card-arrow svg { width: 0.85rem; height: 0.85rem; }
  .card:hover .card-arrow { background: #FE5C17; color: #fff; transform: translateX(3px); }

  /* ---------- empty ---------- */
  .empty {
    margin-top: 2rem; padding: clamp(2.25rem, 5vw, 3.5rem); text-align: center;
    border-top: 1px solid #eceff4;
  }
  .empty[hidden] { display: none; }
  .empty p { margin: 0 0 0.85rem; color: #6b7280; font-size: 0.95rem; }
  .empty strong { color: #0A0E17; }
  .reset {
    border: 0; background: none; cursor: pointer; padding: 0;
    color: #FE5C17; font-size: 0.88rem; font-weight: 700;
    text-decoration: underline; text-underline-offset: 4px;
  }
  .reset:hover { color: #C93A00; }

  @media (prefers-reduced-motion: reduce) {
    .card, .feat, .card-media img, .feat-media img { transition: none; }
    .card:hover, .feat:hover { transform: none; }
  }
</style>

<script>
  function initBlog() {
    const grid = document.getElementById('postGrid');
    if (!grid || grid.dataset.ready) return;
    grid.dataset.ready = 'true';

    const nav = document.getElementById('nav');
    const setNav = () => {
      if (!nav) return;
      document.documentElement.style.setProperty('--nav-h', `${Math.round(nav.getBoundingClientRect().bottom)}px`);
    };
    setNav();
    window.addEventListener('resize', setNav);

    const norm = (s = '') => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const filterBar = document.getElementById('tagFilter');
    const chips: HTMLElement[] = Array.from(
      filterBar ? filterBar.querySelectorAll<HTMLElement>('.chip') : []
    );
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.card'));
    const featWrap = document.querySelector<HTMLElement>('.featured-wrap');
    const feat = featWrap?.querySelector<HTMLElement>('.feat') ?? null;
    const input = document.getElementById('searchInput') as HTMLInputElement | null;
    const countEl = document.getElementById('railCount');
    const empty = document.getElementById('emptyState');
    const emptyQuery = document.getElementById('emptyQuery');
    const resetBtn = document.getElementById('resetFilters');
    const gridTitle = document.getElementById('gridTitle');

    let tag = 'all';
    let query = '';

    const matches = (el: HTMLElement) => {
      const tags = (el.dataset.tags || '').split(',').filter(Boolean);
      const tagOk = tag === 'all' || tags.includes(tag);
      const q = norm(query.trim());
      const qOk = !q || norm(el.dataset.search || '').includes(q);
      return tagOk && qOk;
    };

    const apply = () => {
      let visible = 0;
      if (featWrap && feat) {
        const ok = matches(feat);
        featWrap.hidden = !ok;
        if (ok) visible++;
      }
      cards.forEach(card => {
        const ok = matches(card);
        card.hidden = !ok;
        if (ok) visible++;
      });

      if (countEl) {
        countEl.innerHTML = `<strong>${visible}</strong> ${visible === 1 ? 'artigo' : 'artigos'}`;
      }
      const filtered = tag !== 'all' || query.trim().length > 0;
      if (gridTitle) gridTitle.textContent = filtered ? 'Resultados' : 'Todos os artigos';
      if (empty) empty.hidden = visible !== 0;
      if (emptyQuery && query.trim()) emptyQuery.textContent = `“${query.trim()}”`;
    };

    const syncUrl = () => {
      const url = new URL(window.location.href);
      if (tag === 'all') url.searchParams.delete('tag');
      else url.searchParams.set('tag', tag);
      if (query.trim()) url.searchParams.set('q', query.trim());
      else url.searchParams.delete('q');
      window.history.replaceState(null, '', url);
    };

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        tag = chip.dataset.tag || 'all';
        chips.forEach(c => {
          const active = c === chip;
          c.classList.toggle('is-active', active);
          c.setAttribute('aria-pressed', String(active));
        });
        apply();
        syncUrl();
      });
    });

    let debounce: number | undefined;
    input?.addEventListener('input', () => {
      window.clearTimeout(debounce);
      debounce = window.setTimeout(() => {
        query = input.value;
        apply();
        syncUrl();
      }, 160);
    });

    resetBtn?.addEventListener('click', () => {
      tag = 'all';
      query = '';
      if (input) input.value = '';
      chips.forEach(c => {
        const active = c.dataset.tag === 'all';
        c.classList.toggle('is-active', active);
        c.setAttribute('aria-pressed', String(active));
      });
      apply();
      syncUrl();
      input?.focus();
    });

    const params = new URLSearchParams(window.location.search);
    const startTag = params.get('tag');
    const startQ = params.get('q');
    if (startQ && input) {
      input.value = startQ;
      query = startQ;
    }
    if (startTag && chips.some(c => c.dataset.tag === startTag)) {
      tag = startTag;
      chips.forEach(c => {
        const active = c.dataset.tag === startTag;
        c.classList.toggle('is-active', active);
        c.setAttribute('aria-pressed', String(active));
      });
    }
    apply();
  }

  document.addEventListener('astro:page-load', initBlog);
  document.addEventListener('DOMContentLoaded', initBlog);
</script>
