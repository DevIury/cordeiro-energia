---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import CtaSection from '../../components/CtaSection.astro';
import Analytics from '../../components/Analytics.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const relatedPosts = (await getCollection('blog'))
  .filter(p => p.id !== post.id && !p.data.draft)
  .filter(p => p.data.tags.some(t => post.data.tags.includes(t)))
  .slice(0, 3);

const tagColors: Record<string, string> = {
  'energia solar': '#FE5C17',
  'economia': '#00C853',
  'guia': '#2196F3',
  'conta de luz': '#FF9800',
  'manutenção': '#9C27B0',
  'curvelo': '#FE5C17',
  'dicas': '#00BCD4',
  'sustentabilidade': '#4CAF50',
  'instalação': '#FF5722',
};

function getTagColor(tag: string): string {
  return tagColors[tag] || '#6b7280';
}
---

<Layout
  title={`${post.data.title} - Cordeiro Energia`}
  description={post.data.description}
  ogType="article"
>
  <Header />

  <main>
    <!-- Article header -->
    <section style="padding:6rem 0 3rem;background:#ffffff;">
      <div class="container" style="max-width:760px;margin:0 auto;">
        <!-- Breadcrumb -->
        <nav style="margin-bottom:2rem;">
          <a href="/" style="color:#9ca3af;text-decoration:none;font-size:0.8rem;">Home</a>
          <span style="color:#d1d5db;margin:0 0.5rem;font-size:0.8rem;">/</span>
          <a href="/blog" style="color:#9ca3af;text-decoration:none;font-size:0.8rem;">Blog</a>
          <span style="color:#d1d5db;margin:0 0.5rem;font-size:0.8rem;">/</span>
          <span style="color:#6b7280;font-size:0.8rem;">{post.data.title}</span>
        </nav>

        <!-- Meta: date, reading time, author -->
        <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.25rem;">
          <time style="font-size:0.8rem;color:#9ca3af;" datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
          </time>
          <span style="color:#d1d5db;">·</span>
          <span style="font-size:0.8rem;color:#9ca3af;">{post.data.author}</span>
        </div>

        <!-- Tags -->
        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.5rem;">
          {post.data.tags.map((tag) => (
            <span style={`font-size:0.7rem;font-weight:600;padding:0.35rem 0.75rem;border-radius:9999px;background:${getTagColor(tag)}15;color:${getTagColor(tag)};border:1px solid ${getTagColor(tag)}25;`}>
              {tag}
            </span>
          ))}
        </div>

        <h1 style="font-size:2.75rem;font-weight:900;color:#111;line-height:1.12;margin-bottom:1rem;letter-spacing:-0.025em;">
          {post.data.title}
        </h1>

        <p style="font-size:1.1rem;color:#6b7280;line-height:1.7;">
          {post.data.description}
        </p>
      </div>
    </section>

    <!-- Article content -->
    <section style="padding:3.5rem 0 5rem;background:#ffffff;">
      <div class="container" style="max-width:760px;margin:0 auto;">
        {post.data.image && (
          <div style="margin-bottom:2.5rem;border-radius:0.75rem;overflow:hidden;">
            <img src={post.data.image} alt={post.data.title} style="width:100%;height:auto;display:block;" loading="lazy" />
          </div>
        )}
        <article class="blog-content">
          <Content />
        </article>
      </div>
    </section>

    <!-- Related posts -->
    {relatedPosts.length > 0 && (
      <section style="padding:3.5rem 0 4rem;background:#f9fafb;">
        <div class="container">
          <h2 style="font-size:1.75rem;font-weight:800;color:#111;margin-bottom:2rem;text-align:center;">
            Artigos <span style="color:#FE5C17;">Relacionados</span>
          </h2>
          <div style="display:grid;grid-template-columns:repeat(1,1fr);gap:1.5rem;max-width:900px;margin:0 auto;" class="related-grid">
            {relatedPosts.map((related) => (
              <a
                href={`/blog/${related.id}`}
                style="text-decoration:none;display:flex;gap:1rem;padding:1.25rem;background:#fff;border-radius:0.75rem;border:1px solid #f3f4f6;transition:all 0.3s;"
                class="related-card"
              >
                <div style="width:4rem;height:4rem;min-width:4rem;border-radius:0.5rem;background:linear-gradient(135deg,#FFF5ED,#FFF0E6);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <svg style="width:1.5rem;height:1.5rem;" viewBox="0 0 24 24" fill="none" stroke="#FE5C17" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/></svg>
                </div>
                <div>
                  <h3 style="font-size:0.95rem;font-weight:700;color:#111;line-height:1.35;margin-bottom:0.35rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                    {related.data.title}
                  </h3>
                  <p style="font-size:0.8rem;color:#6b7280;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                    {related.data.description}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <CtaSection />
  </main>

  <FloatingWhatsApp />
  <Footer />
  <Analytics />
</Layout>

<style is:global>
  .related-grid { grid-template-columns: 1fr; }
  @media (min-width: 640px) { .related-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .related-grid { grid-template-columns: repeat(3, 1fr); } }

  .related-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.06);
    border-color: rgba(254,92,23,0.15);
  }
  .related-card:hover h3 { color: #FE5C17 !important; }

  .blog-content { font-size: 1.1rem; line-height: 1.9; color: #374151; }
  .blog-content h1 { font-size: 2.75rem; font-weight: 900; color: #111; margin: 4rem 0 1.5rem; line-height: 1.15; letter-spacing: -0.025em; }
  .blog-content h2 { font-size: 2rem; font-weight: 800; color: #111; margin: 4.5rem 0 1.25rem; line-height: 1.2; letter-spacing: -0.02em; }
  .blog-content h3 { font-size: 1.4rem; font-weight: 600; color: #FE5C17; margin: 3.5rem 0 1rem; line-height: 1.3; }
  .blog-content h4 { font-size: 1.25rem; font-weight: 700; color: #111; margin: 3rem 0 0.75rem; line-height: 1.35; }
  .blog-content h5 { font-size: 1.1rem; font-weight: 700; color: #111; margin: 2.5rem 0 0.6rem; line-height: 1.35; }
  .blog-content h6 { font-size: 1rem; font-weight: 700; color: #111; margin: 2rem 0 0.5rem; line-height: 1.35; }
  .blog-content p { margin-bottom: 1.75rem; }
  .blog-content strong { color: #111; font-weight: 700; }
  .blog-content ul, .blog-content ol { margin: 1rem 0 1.5rem 1.5rem; }
  .blog-content li { margin-bottom: 0.6rem; line-height: 1.7; }
  .blog-content a { color: #FE5C17; text-decoration: underline; text-underline-offset: 2px; font-weight: 600; }
  .blog-content a:hover { color: #E04400; }
  .blog-content table { width: 100%; border-collapse: collapse; margin: 2rem 0; font-size: 0.95rem; }
  .blog-content th, .blog-content td { padding: 0.75rem 1rem; text-align: left; border-bottom: 1px solid #e5e7eb; }
  .blog-content th { font-weight: 700; color: #111; background: #f9fafb; }
  .blog-content tr:hover { background: #f9fafb; }
  .blog-content hr { border: none; border-top: 1px solid #e5e7eb; margin: 3rem 0; }
  .blog-content blockquote { border-left: 4px solid #FE5C17; padding: 1rem 1.5rem; margin: 2rem 0; background: #fff7ed; border-radius: 0 0.5rem 0.5rem 0; color: #374151; }
</style>
