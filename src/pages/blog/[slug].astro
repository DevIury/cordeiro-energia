---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CtaSection from '../../components/CtaSection.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const sorted = posts
    .filter(p => !p.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return sorted.map((post, i) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: {
      post,
      prev: i < sorted.length - 1 ? sorted[i + 1] : null,
      next: i > 0 ? sorted[i - 1] : null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);

const allPosts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestPosts = allPosts.filter(p => p.id !== post.id).slice(0, 5);

const rawBody = typeof post.body === 'string' ? post.body : post.data.description;
const wordCount = rawBody.trim().split(/\s+/).filter(Boolean).length;
const readingMin = Math.max(1, Math.round(wordCount / 200));

const matched = allPosts
  .filter(p => p.id !== post.id)
  .map(p => ({ p, score: p.data.tags.filter(t => post.data.tags.includes(t)).length }))
  .filter(x => x.score > 0)
  .sort((a, b) => b.score - a.score || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
  .map(x => x.p);

const relatedPosts = [...matched, ...allPosts.filter(p => p.id !== post.id && !matched.includes(p))].slice(0, 3);

const tagColors: Record<string, string> = {
  'energia solar': '#FE5C17',
  'economia': '#00C853',
  'guia': '#2196F3',
  'conta de luz': '#FF9800',
  'manutenção': '#9C27B0',
  'curvelo': '#FE5C17',
  'dicas': '#00BCD4',
  'sustentabilidade': '#4CAF50',
  'instalação': '#FF5722',
};

function getTagColor(tag: string): string {
  return tagColors[tag] || '#6b7280';
}

const slug = post.id.replace(/\.md$/, '');
const pageUrl = `${Astro.url.origin}/blog/${slug}`;
const shareText = encodeURIComponent(post.data.title);
const pubDateISO = post.data.pubDate.toISOString();
const pubDateBR = post.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
const pubDateShort = post.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
---

<Layout
  title={`${post.data.title} - Cordeiro Energia`}
  description={post.data.description}
  ogType="article"
>
  <Header />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": pubDateISO,
    "keywords": post.data.tags.join(', '),
    "wordCount": wordCount,
    "author": {
      "@type": "Organization",
      "name": post.data.author || "Cordeiro Energia"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Cordeiro Energia",
      "logo": {
        "@type": "ImageObject",
        "url": "/logo.png"
      }
    },
    "image": post.data.image || "/og-image.svg",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://cordeiro-energia.pages.dev/blog/${slug}`
    }
  })} />

  <div class="read-progress" aria-hidden="true"><i id="readBar"></i></div>

  <main>
    <section class="post-head">
      <div class="container">
        <nav class="crumbs" aria-label="Navegação estrutural">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href="/blog">Blog</a><span aria-hidden="true">/</span>
          <span aria-current="page">{post.data.title}</span>
        </nav>

        <div class="post-meta">
          <time datetime={pubDateISO}>{pubDateBR}</time>
          <span class="meta-dot" aria-hidden="true"></span>
          <span>{post.data.author}</span>
          <span class="meta-dot" aria-hidden="true"></span>
          <span class="meta-read">{readingMin} min de leitura</span>
        </div>

        <div class="post-tags">
          {post.data.tags.map((tag) => (
            <a href={`/blog?tag=${encodeURIComponent(tag)}`} class="post-tag" style={`--tc:${getTagColor(tag)}`}>{tag}</a>
          ))}
        </div>

        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-desc">{post.data.description}</p>

        <div class="share">
          <span class="share-label">Compartilhar</span>
          <div class="share-btns">
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${pageUrl}`} target="_blank" rel="noopener noreferrer" class="share-btn" style="--sc:#1877F2">
              <svg fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              Facebook
            </a>
            <a href={`https://twitter.com/intent/tweet?url=${pageUrl}&text=${shareText}`} target="_blank" rel="noopener noreferrer" class="share-btn" style="--sc:#111111">
              <svg fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              X
            </a>
            <a href={`https://wa.me/?text=${shareText}%20${pageUrl}`} target="_blank" rel="noopener noreferrer" class="share-btn" style="--sc:#25D366">
              <svg fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp
            </a>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${pageUrl}`} target="_blank" rel="noopener noreferrer" class="share-btn" style="--sc:#0A66C2">
              <svg fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
            <a href={`mailto:?subject=${shareText}&body=${pageUrl}`} class="share-btn" style="--sc:#6b7280">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              Email
            </a>
            <button type="button" class="share-btn share-copy" id="copyLink">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
              <span>Copiar link</span>
            </button>
          </div>
        </div>

        {post.data.image && (
          <figure class="post-cover">
            <img
              src={post.data.image}
              alt={post.data.title}
              width="1200"
              height="630"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        )}
      </div>
    </section>

    <section class="post-body">
      <div class="container post-layout">
        <div class="post-main">
          <article class="post-content" id="postContent">
            <Content />
          </article>

          <nav class="post-nav" aria-label="Navegação entre artigos">
            {prev && (
              <a href={`/blog/${prev.id.replace(/\.md$/, '')}`} class="post-nav-link">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                <span>
                  <small>Artigo anterior</small>
                  <strong>{prev.data.title}</strong>
                </span>
              </a>
            )}
            {next && (
              <a href={`/blog/${next.id.replace(/\.md$/, '')}`} class="post-nav-link is-next">
                <span>
                  <small>Próximo artigo</small>
                  <strong>{next.data.title}</strong>
                </span>
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </a>
            )}
          </nav>

          {relatedPosts.length > 0 && (
            <section class="related" aria-labelledby="relatedTitle">
              <h2 class="related-title" id="relatedTitle">Continue lendo</h2>
              <div class="related-grid">
                {relatedPosts.map((rp) => (
                  <a href={`/blog/${rp.id.replace(/\.md$/, '')}`} class="rel-card">
                    <span class="rel-img">
                      {rp.data.image && <img src={rp.data.image} alt={rp.data.title} width="600" height="375" loading="lazy" decoding="async" />}
                    </span>
                    <span class="rel-body">
                      <span class="rel-tag" style={`color:${getTagColor(rp.data.tags[0] || '')}`}>{rp.data.tags[0] || 'Blog'}</span>
                      <span class="rel-title">{rp.data.title}</span>
                      <span class="rel-date">{rp.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' })}</span>
                    </span>
                  </a>
                ))}
              </div>
            </section>
          )}
        </div>

        <aside class="post-aside">
          <div class="aside-sticky">
            <nav class="toc" id="toc" aria-label="Neste artigo" hidden>
              <p class="aside-title">Neste artigo</p>
              <ol class="toc-list" id="tocList"></ol>
            </nav>

            <div class="aside-latest">
              <p class="aside-title">Últimos artigos</p>
              {latestPosts.map((lp, i) => (
                <a href={`/blog/${lp.id.replace(/\.md$/, '')}`} class="side-card">
                  <span class="side-n">{String(i + 1).padStart(2, '0')}</span>
                  <span class="side-body">
                    <strong>{lp.data.title}</strong>
                    <time>{lp.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' })}</time>
                  </span>
                </a>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </section>

    <CtaSection />
  </main>

  <Footer />
</Layout>

<style is:global>
  /* ---------- progress ---------- */
  .read-progress {
    position: fixed; left: 0; right: 0; top: var(--nav-h, 76px);
    height: 3px; background: rgba(10, 14, 23, 0.08); z-index: 49; pointer-events: none;
  }
  .read-progress i {
    display: block; height: 100%; width: 100%;
    background: linear-gradient(90deg, #FE5C17, #FFC107);
    transform: scaleX(0); transform-origin: 0 50%; will-change: transform;
  }

  /* ---------- header ---------- */
  .post-head {
    position: relative;
    padding: clamp(5.5rem, 10vw, 7rem) 0 clamp(2rem, 4vw, 3rem);
    background-color: #ffffff;
    background-image: radial-gradient(48rem 24rem at 88% -35%, rgba(254, 92, 23, 0.12), transparent 70%);
    border-bottom: 1px solid #eef1f6;
  }
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: 0.78rem; margin-bottom: 1.5rem; }
  .crumbs a { color: #9ca3af; text-decoration: none; transition: color 0.2s; }
  .crumbs a:hover { color: #FE5C17; }
  .crumbs span[aria-hidden] { color: #d1d5db; }
  .crumbs [aria-current] { color: #111; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: min(60vw, 34rem); }

  .post-meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-bottom: 1.15rem;
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.72rem; letter-spacing: 0.06em; color: #6b7280; text-transform: uppercase;
  }
  .meta-dot { width: 4px; height: 4px; border-radius: 50%; background: #FE5C17; }
  .meta-read { color: #FE5C17; font-weight: 700; }

  .post-tags { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: 1.35rem; }
  .post-tag {
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.04em;
    padding: 0.35rem 0.75rem; border-radius: 999px; text-decoration: none;
    color: var(--tc); background: color-mix(in srgb, var(--tc) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--tc) 28%, transparent);
    transition: transform 0.2s, background-color 0.2s;
  }
  .post-tag:hover { transform: translateY(-2px); background: color-mix(in srgb, var(--tc) 18%, transparent); }

  .post-title {
    font-size: clamp(1.85rem, 4.4vw, 3rem); font-weight: 800; color: #111;
    line-height: 1.1; letter-spacing: -0.035em; margin: 0 0 1rem; max-width: 22ch;
    text-wrap: balance;
  }
  .post-desc { font-size: clamp(1rem, 1.6vw, 1.15rem); color: #6b7280; line-height: 1.7; max-width: 62ch; margin: 0 0 1.75rem; }

  .share { display: flex; flex-wrap: wrap; align-items: center; gap: 0.55rem; }
  .share-label {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: #9ca3af;
    margin-right: 0.35rem;
  }
  .share-btn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.5rem 0.9rem; border: 0; border-radius: 999px; cursor: pointer;
    background: var(--sc, #111827); color: #fff;
    font-family: inherit; font-size: 0.72rem; font-weight: 700; text-decoration: none;
    box-shadow: 0 6px 16px rgba(10, 14, 23, 0.14);
    transition: transform 0.25s, box-shadow 0.25s, filter 0.25s;
  }
  .share-btn svg { width: 0.85rem; height: 0.85rem; flex-shrink: 0; }
  .share-btn:hover { transform: translateY(-2px); filter: brightness(1.08); box-shadow: 0 12px 24px rgba(10, 14, 23, 0.2); }
  .share-copy { --sc: #111827; }
  .share-copy.is-done { --sc: #00A854; }

  .post-cover {
    margin: clamp(2rem, 4vw, 2.75rem) 0 0; border-radius: 1.25rem; overflow: hidden;
    border: 1px solid #eef1f6; box-shadow: 0 30px 70px rgba(10, 14, 23, 0.16);
    background: #0A0E17;
  }
  .post-cover img { display: block; width: 100%; height: auto; aspect-ratio: 2 / 1; object-fit: cover; }

  /* ---------- layout ---------- */
  .post-body { background: #ffffff; padding-bottom: clamp(3rem, 7vw, 5rem); }
  .container.post-layout {
    display: grid; gap: clamp(2rem, 4vw, 3rem);
    padding-top: clamp(2rem, 4vw, 3.25rem);
  }
  .post-layout > * { min-width: 0; }
  .post-main { max-width: 720px; }
  .post-aside { order: -1; }
  .aside-latest { display: none; }
  .aside-sticky { position: sticky; top: calc(var(--nav-h, 76px) + 1.25rem); }
  @media (min-width: 1024px) {
    .container.post-layout { grid-template-columns: minmax(0, 1fr) 300px; }
    .post-aside { order: 0; }
    .aside-latest { display: block; }
  }

  /* ---------- aside / TOC ---------- */
  .toc {
    background: #fff; border: 1px solid #eef1f6; border-radius: 1rem;
    padding: 1.1rem 1.05rem 1.15rem; box-shadow: 0 12px 30px rgba(10, 14, 23, 0.05);
    margin-bottom: 1.25rem;
  }
  .toc[hidden] { display: none; }
  .aside-title {
    display: flex; align-items: center; gap: 0.55rem; margin: 0 0 0.9rem;
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: #9ca3af;
  }
  .aside-title::before { content: ''; width: 1.4rem; height: 2px; border-radius: 99px; background: linear-gradient(90deg, #FE5C17, #FFC107); }
  .toc-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; max-height: 11rem; overflow-y: auto; }
  .toc-item a {
    display: block; padding: 0.4rem 0.55rem; border-left: 2px solid #eef1f6;
    color: #4b5563; font-size: 0.82rem; line-height: 1.45; text-decoration: none;
    border-radius: 0 0.5rem 0.5rem 0; transition: color 0.2s, background-color 0.2s, border-color 0.2s;
    overflow-wrap: anywhere;
  }
  .toc-item a:hover { color: #FE5C17; background: #fff7ed; }
  .toc-item.is-active > a { color: #FE5C17; background: #fff7ed; border-left-color: #FE5C17; font-weight: 700; }
  .toc-item.toc-sub a { padding-left: 1.35rem; font-size: 0.78rem; color: #6b7280; }
  @media (min-width: 1024px) { .toc-list { max-height: min(52vh, 26rem); } }

  .aside-latest { border-top: 1px solid #eef1f6; padding-top: 1.25rem; }
  .side-card {
    display: flex; gap: 0.7rem; align-items: flex-start; text-decoration: none;
    padding: 0.7rem 0.75rem; border: 1px solid transparent; border-radius: 0.75rem;
    transition: background-color 0.2s, border-color 0.2s, transform 0.2s;
  }
  .side-card + .side-card { margin-top: 0.15rem; }
  .side-card:hover { background: #f9fafb; border-color: #eef1f6; transform: translateX(3px); }
  .side-n {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.66rem; letter-spacing: 0.1em; color: #FE5C17; padding-top: 0.15rem;
  }
  .side-body { min-width: 0; }
  .side-body strong {
    display: block; font-size: 0.85rem; font-weight: 600; color: #111; line-height: 1.4;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    overflow-wrap: anywhere;
  }
  .side-card:hover strong { color: #FE5C17; }
  .side-body time { display: block; margin-top: 0.25rem; font-size: 0.7rem; color: #9ca3af; }

  /* ---------- article ---------- */
  .post-content {
    font-size: 1.0625rem; line-height: 1.75; color: #3c4552;
    text-wrap: pretty; -webkit-font-smoothing: antialiased;
    counter-reset: sec;
  }
  @media (min-width: 768px) { .post-content { font-size: 1.075rem; line-height: 1.78; } }
  .post-content > *:first-child { margin-top: 0; }
  .post-content p { margin: 0 0 1.35rem; }
  .post-content > p:first-of-type {
    font-size: clamp(1.1rem, 1.5vw, 1.2rem); line-height: 1.65;
    color: #161c26; font-weight: 500;
  }
  .post-content p strong, .post-content li strong {
    color: #0A0E17; font-weight: 700;
    background: linear-gradient(transparent 58%, rgba(255, 193, 7, 0.34) 58%);
    -webkit-box-decoration-break: clone; box-decoration-break: clone;
  }
  .post-content a {
    color: #C93A00; font-weight: 600; text-decoration: underline;
    text-decoration-color: rgba(254, 92, 23, 0.45); text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em; transition: color 0.2s, text-decoration-color 0.2s;
  }
  .post-content a:hover { color: #FE5C17; text-decoration-color: #FE5C17; }

  .post-content h2, .post-content h3 { scroll-margin-top: calc(var(--nav-h, 76px) + 1.5rem); text-wrap: balance; }
  .post-content h2 {
    counter-increment: sec;
    margin: 3.4rem 0 1.15rem; padding-bottom: 0.7rem;
    font-size: clamp(1.45rem, 2.7vw, 2rem); font-weight: 800; color: #0A0E17;
    letter-spacing: -0.03em; line-height: 1.18;
    background: linear-gradient(90deg, #FE5C17, #FFC107) no-repeat left bottom / 2.75rem 3px;
  }
  .post-content h2::before {
    content: counter(sec, decimal-leading-zero);
    display: block; margin-bottom: 0.55rem;
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em; color: #FE5C17;
  }
  .post-content h3 {
    margin: 2.6rem 0 0.9rem; padding-left: 0.9rem;
    border-left: 3px solid #FE5C17;
    font-size: clamp(1.12rem, 1.9vw, 1.32rem); font-weight: 700; color: #0A0E17;
    line-height: 1.32;
  }
  .post-content h4 { font-size: 1rem; font-weight: 700; color: #0A0E17; margin: 2rem 0 0.75rem; line-height: 1.35; }

  .post-content ul, .post-content ol { list-style: none; margin: 1.3rem 0 1.6rem; padding: 0; }
  .post-content li { position: relative; padding-left: 1.7rem; margin-bottom: 0.7rem; line-height: 1.7; }
  .post-content li > ul, .post-content li > ol { margin: 0.7rem 0 0; }
  .post-content ul > li::before {
    content: ''; position: absolute; left: 0.1rem; top: 0.66em;
    width: 0.5rem; height: 0.5rem; border-radius: 0.16rem;
    background: linear-gradient(135deg, #FE5C17, #FFC107);
  }
  .post-content ol { counter-reset: step; }
  .post-content ol > li { counter-increment: step; padding-left: 2.15rem; }
  .post-content ol > li::before {
    content: counter(step, decimal-leading-zero);
    position: absolute; left: 0; top: 0.3em;
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; color: #FE5C17;
  }

  .post-content table {
    display: block; width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch;
    border-collapse: separate; border-spacing: 0; margin: 2.25rem 0; font-size: 0.94rem; line-height: 1.5;
    background: #fff; border: 1px solid #e8ecf3; border-radius: 1rem;
    box-shadow: 0 14px 34px rgba(10, 14, 23, 0.06);
  }
  .post-content th, .post-content td {
    padding: 0.85rem 1.1rem; text-align: left; vertical-align: top;
    border-bottom: 1px solid #eef1f6;
  }
  .post-content th {
    background: #0A0E17; color: #fff; font-weight: 700; font-size: 0.7rem;
    text-transform: uppercase; letter-spacing: 0.1em; white-space: nowrap;
    border-bottom: none;
  }
  .post-content tbody td:first-child { font-weight: 600; color: #0A0E17; }
  .post-content tbody tr:last-child td { border-bottom: none; }
  .post-content tbody tr:nth-child(even) td { background: #f8fafc; }
  .post-content tbody tr:hover td { background: #fff7ed; }
  .post-content hr {
    border: none; width: 6rem; height: 2px; margin: 3rem auto;
    background: linear-gradient(90deg, transparent, #FE5C17, transparent);
  }
  .post-content img { display: block; max-width: 100%; height: auto; border-radius: 1rem; border: 1px solid #eef1f6; margin: 2.25rem 0; }
  .post-content p:has(> img) { margin: 2.25rem 0; }
  .post-content blockquote {
    margin: 2.25rem 0; padding: 1.35rem 1.6rem; background: #0A0E17; border-radius: 1.25rem;
    color: #A8B0BD; font-size: 1.02rem; line-height: 1.75;
    border-left: 3px solid #FE5C17;
  }
  .post-content blockquote p:last-child { margin-bottom: 0; }
  .post-content blockquote strong { color: #FE5C17; background: none; }
  .post-content code {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.87em; background: #f1f4f9; color: #0A0E17;
    padding: 0.12rem 0.4rem; border: 1px solid #e5e9f0; border-radius: 0.4rem;
  }

  /* ---------- prev / next ---------- */
  .post-nav {
    display: flex; flex-direction: column; gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem); padding-top: 2rem; border-top: 1px solid #e5e7eb;
  }
  @media (min-width: 640px) { .post-nav { flex-direction: row; } }
  .post-nav-link {
    display: flex; align-items: center; gap: 0.85rem; flex: 1; min-width: 0;
    padding: 1.1rem 1.25rem; border-radius: 1rem; text-decoration: none;
    border: 1px solid #eef1f6; background: #fff;
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
  }
  .post-nav-link:hover {
    border-color: #FE5C17; transform: translateY(-3px);
    box-shadow: 0 18px 36px rgba(10, 14, 23, 0.08);
  }
  .post-nav-link svg { width: 1.1rem; height: 1.1rem; color: #FE5C17; flex-shrink: 0; }
  .post-nav-link span { min-width: 0; }
  .post-nav-link small {
    display: block; font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.65rem; letter-spacing: 0.14em; text-transform: uppercase; color: #9ca3af; margin-bottom: 0.3rem;
  }
  .post-nav-link strong { display: block; font-size: 0.9rem; color: #111; line-height: 1.35; }
  .post-nav-link:hover strong { color: #FE5C17; }
  @media (min-width: 640px) {
    .post-nav-link.is-next { text-align: right; justify-content: flex-end; }
  }

  /* ---------- related ---------- */
  .related { margin-top: clamp(2.5rem, 5vw, 3.5rem); padding-top: clamp(2rem, 4vw, 2.75rem); border-top: 1px solid #e5e7eb; }
  .related-title {
    display: flex; align-items: center; gap: 0.65rem; margin: 0 0 1.4rem;
    font-size: clamp(1.15rem, 2vw, 1.4rem); font-weight: 800; color: #111; letter-spacing: -0.025em;
  }
  .related-title::before { content: ''; width: 1.75rem; height: 3px; border-radius: 99px; background: linear-gradient(90deg, #FE5C17, #FFC107); }
  .related-grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  .rel-card {
    display: flex; flex-direction: column; text-decoration: none; background: #fff;
    border: 1px solid #eef1f6; border-radius: 1rem; overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
  }
  .rel-card:hover { transform: translateY(-5px); border-color: #FE5C17; box-shadow: 0 22px 46px rgba(10, 14, 23, 0.12); }
  .rel-img { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #0A0E17; }
  .rel-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.3, 1); }
  .rel-card:hover .rel-img img { transform: scale(1.07); }
  .rel-body { display: flex; flex-direction: column; gap: 0.4rem; padding: 0.95rem 1.05rem 1.15rem; flex: 1; }
  .rel-tag {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase;
  }
  .rel-title { font-size: 0.95rem; font-weight: 700; color: #111; line-height: 1.4; }
  .rel-card:hover .rel-title { color: #FE5C17; }
  .rel-date { margin-top: auto; padding-top: 0.35rem; font-size: 0.7rem; color: #9ca3af; }

  @media (prefers-reduced-motion: reduce) {
    .read-progress i { transition: none; }
    .rel-card, .share-btn, .post-nav-link, .side-card { transition: none; }
    .rel-card:hover, .share-btn:hover, .post-nav-link:hover, .side-card:hover { transform: none; }
  }
</style>

<script>
  let tocItems: { link: HTMLAnchorElement; target: HTMLElement }[] = [];
  let bound = false;
  let frame = 0;

  function navOffset(): number {
    const nav = document.getElementById('nav');
    return nav ? Math.round(nav.getBoundingClientRect().bottom) : 76;
  }

  function updatePost() {
    frame = 0;
    const offset = navOffset();
    document.documentElement.style.setProperty('--nav-h', `${offset}px`);

    const bar = document.getElementById('readBar');
    if (bar) {
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      bar.style.transform = `scaleX(${ratio})`;
    }

    if (tocItems.length) {
      const line = offset + 48;
      let active = -1;
      tocItems.forEach((it, i) => { if (it.target.getBoundingClientRect().top <= line) active = i; });
      tocItems.forEach((it, i) => it.link.parentElement?.classList.toggle('is-active', i === active));
    }
  }

  function schedule() {
    if (!frame) frame = window.requestAnimationFrame(updatePost);
  }

  function buildToc(content: HTMLElement) {
    const toc = document.getElementById('toc');
    const list = document.getElementById('tocList');
    tocItems = [];
    if (!toc || !list) return;
    list.innerHTML = '';

    const headings = Array.from(content.querySelectorAll<HTMLElement>('h2, h3'));
    const h2Count = headings.filter(h => h.tagName === 'H2').length;
    const useH3 = h2Count < 6;
    const items = headings.filter(h => h.tagName === 'H2' || useH3);

    items.forEach((h, i) => { if (!h.id) h.id = `secao-${i + 1}`; });

    if (items.length > 1) {
      items.forEach((h) => {
        const li = document.createElement('li');
        li.className = h.tagName === 'H3' ? 'toc-item toc-sub' : 'toc-item';
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.textContent = (h.textContent || '').trim();
        li.appendChild(a);
        list.appendChild(li);
        tocItems.push({ link: a, target: h });
      });
      toc.hidden = false;
    } else {
      toc.hidden = true;
    }

    list.addEventListener('click', (ev) => {
      const a = (ev.target as HTMLElement | null)?.closest?.('a');
      if (!(a instanceof HTMLAnchorElement)) return;
      const id = (a.getAttribute('href') || '').slice(1);
      const target = id ? document.getElementById(id) : null;
      if (!target) return;
      ev.preventDefault();
      const y = target.getBoundingClientRect().top + window.scrollY - navOffset() - 24;
      window.scrollTo({ top: y, behavior: 'smooth' });
      history.replaceState(null, '', `#${id}`);
      schedule();
    });
  }

  function initCopy() {
    const btn = document.getElementById('copyLink');
    if (!(btn instanceof HTMLButtonElement) || btn.dataset.ready === '1') return;
    btn.dataset.ready = '1';
    const label = btn.querySelector('span');
    btn.addEventListener('click', async () => {
      const url = window.location.href;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch { /* noop */ }
        ta.remove();
      }
      btn.classList.add('is-done');
      if (label) label.textContent = 'Link copiado!';
      window.setTimeout(() => {
        btn.classList.remove('is-done');
        if (label) label.textContent = 'Copiar link';
      }, 2200);
    });
  }

  function initPost() {
    const content = document.getElementById('postContent');
    if (!content || content.dataset.ready === '1') return;
    content.dataset.ready = '1';

    buildToc(content);
    initCopy();

    if (!bound) {
      bound = true;
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule, { passive: true });
      window.addEventListener('load', schedule, { once: true });
    }
    schedule();
  }

  document.addEventListener('astro:page-load', initPost);
  document.addEventListener('DOMContentLoaded', initPost);
</script>
