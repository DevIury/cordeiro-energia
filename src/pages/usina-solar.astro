---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
import StatsBand from '../components/StatsBand.astro';
import VantagensBand from '../components/VantagensBand.astro';
import ProcessoSection from '../components/ProcessoSection.astro';
import FaqBand from '../components/FaqBand.astro';
---

<Layout
  title="Usinas Solar - Cordeiro Energia | Geração Distribuída e Centralizada"
  description="Projetos de usinas solares de grande porte. Geração distribuída e centralizada com gestão profissional. Invista em energia limpa."
>
  <Header />

  <main>
    <!-- Hero -->
    <section class="hero" style="min-height:70vh;">
      <div class="hero-bg">
        <img src="/cat-usina.webp" alt="Usina solar" fetchpriority="high" width="1920" height="1080" />
        <div class="hero-overlay"></div>
      </div>
      <div class="container hero-content">
        <div class="hero-badge">
          <svg style="width:1rem;height:1rem;" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><path d="M12 1v3M12 20v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M1 12h3M20 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
          Geração de Energia
        </div>
        <h1 style="font-size:2.5rem;">Usinas <span>Solares</span></h1>
        <p>Projetos de geração distribuída e centralizada com tecnologia de ponta. Do desenvolvimento à operação, cuidamos de tudo.</p>
        <div class="hero-btns">
          <a href="https://wa.me/5538997350343?text=Ol%C3%A1%2C%20tenho%20interesse%20em%20usina%20solar" class="btn btn-orange btn-xl" target="_blank" rel="noopener noreferrer">FALE COM UM ESPECIALISTA
            <svg style="width:1rem;height:1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="#modalidades" class="btn btn-outline btn-xl">MODALIDADES</a>
        </div>
      </div>
    </section>

    <!-- Stats Widget -->
    <StatsBand
      stats={[
        {
          icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>',
          label: 'Clientes atendidos',
          count: 500,
          suffix: '+',
        },
        {
          icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>',
          label: 'Garantia de fábrica',
          count: 25,
          suffix: 'anos',
        },
        {
          icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>',
          label: 'Contratos de longo prazo',
          count: 20,
          suffix: '+ anos',
        },
        {
          icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>',
          label: 'Potência de projeto',
          prefix: 'Até',
          count: 5,
          suffix: 'MW',
        },
      ]}
    />

    <!-- Vantagens -->
    <VantagensBand
      tag="DIFERENCIAIS"
      titleHtml="Nosso <span>diferencial</span>"
      benefits={[
        { title: 'Gestão Completa', text: 'Cuidamos desde a viabilidade técnica até a operação e manutenção da usina.' },
        { title: 'Monitoramento Avançado', text: 'Sistema de monitoramento em tempo real com alertas de performance e manutenção preditiva.' },
        { title: 'Equipe Especializada', text: 'Engenheiros e técnicos com experiência em projetos de grande porte em Minas Gerais.' },
        { title: 'Parceiros de Excelência', text: 'Trabalhamos com os melhores fabricantes: Canadian Solar, Jinko, Huawei, Growatt.' },
      ]}
    />

    <!-- Modalidades -->
    <section id="modalidades" style="padding:5rem 0;">
      <div class="container">
        <div class="section-header">
          <div class="tag">
            <svg style="width:0.75rem;height:0.75rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            MODALIDADES
          </div>
          <h2>Tipos de <span>usinas</span></h2>
        </div>
        <div style="display:grid;gap:1.5rem;grid-template-columns:repeat(auto-fill,minmax(350px,1fr));">
          <div class="card" style="overflow:hidden;">
            <img src="/hero-solar.webp" alt="Usina de geração distribuída" style="width:100%;height:200px;object-fit:cover;" width="400" height="300" loading="lazy" />
            <div style="padding:1.5rem;">
              <div class="tag" style="margin-bottom:1rem;">GERAÇÃO DISTRIBUÍDA</div>
              <h3 style="font-size:1.2rem;font-weight:700;color:#111;margin-bottom:0.5rem;">Usina de Geração Distribuída (GD)</h3>
              <p style="color:#6b7280;font-size:0.9rem;line-height:1.6;margin-bottom:1rem;">Sistemas de até 5MW conectados à rede de distribuição. Permite compensação de energia com a concessionária.</p>
              <ul style="list-style:none;display:flex;flex-direction:column;gap:0.5rem;">
                <li style="display:flex;align-items:center;gap:0.5rem;color:#374151;font-size:0.85rem;">
                  <svg style="width:1rem;height:1rem;color:#FE5C17;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  Incentivos fiscais (ICMS, PIS/COFINS)
                </li>
                <li style="display:flex;align-items:center;gap:0.5rem;color:#374151;font-size:0.85rem;">
                  <svg style="width:1rem;height:1rem;color:#FE5C17;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  Compensação de créditos energéticos
                </li>
                <li style="display:flex;align-items:center;gap:0.5rem;color:#374151;font-size:0.85rem;">
                  <svg style="width:1rem;height:1rem;color:#FE5C17;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  Contratos de compra de energia (CEG)
                </li>
              </ul>
            </div>
          </div>
          <div class="card" style="overflow:hidden;">
            <img src="/sobre-solar.webp" alt="Usina de geração centralizada" style="width:100%;height:200px;object-fit:cover;" width="400" height="300" loading="lazy" />
            <div style="padding:1.5rem;">
              <div class="tag" style="margin-bottom:1rem;">GERAÇÃO CENTRALIZADA</div>
              <h3 style="font-size:1.2rem;font-weight:700;color:#111;margin-bottom:0.5rem;">Usina de Geração Centralizada</h3>
              <p style="color:#6b7280;font-size:0.9rem;line-height:1.6;margin-bottom:1rem;">Grandes usinas conectadas ao sistema de transmissão. Venda de energia para mercado livre ou leilões.</p>
              <ul style="list-style:none;display:flex;flex-direction:column;gap:0.5rem;">
                <li style="display:flex;align-items:center;gap:0.5rem;color:#374151;font-size:0.85rem;">
                  <svg style="width:1rem;height:1rem;color:#FE5C17;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  Potência acima de 5MW
                </li>
                <li style="display:flex;align-items:center;gap:0.5rem;color:#374151;font-size:0.85rem;">
                  <svg style="width:1rem;height:1rem;color:#FE5C17;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  Acesso ao mercado livre de energia
                </li>
                <li style="display:flex;align-items:center;gap:0.5rem;color:#374151;font-size:0.85rem;">
                  <svg style="width:1rem;height:1rem;color:#FE5C17;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  Contratos de longo prazo (20+ anos)
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Como Funciona -->
    <ProcessoSection
      steps={[
        { text: 'Analisamos o potencial e o consumo para indicar a modalidade ideal de usina.' },
        { text: 'Projetamos a usina ideal e estruturamos a viabilidade do investimento.' },
        {},
        { text: 'Do desenvolvimento à operação, cuidamos de tudo para a usina começar a gerar.' },
      ]}
    />

    <!-- FAQ -->
    <FaqBand
      ctaHref="https://wa.me/5538997350343?text=Ol%C3%A1%2C%20tenho%20uma%20d%C3%BAvida%20sobre%20usinas%20solares"
      items={[
        {
          question: 'Qual a diferença entre geração distribuída e centralizada?',
          answer: 'Geração distribuída (GD): sistemas de até 5MW conectados à rede de distribuição, com compensação de energia e incentivos fiscais. Geração centralizada: grandes usinas conectadas ao sistema de transmissão, com venda para o mercado livre ou leilões.',
        },
        {
          question: 'Como vendo a energia excedente?',
          answer: 'A energia pode ser vendida no mercado livre ou em leilões, com contratos de longo prazo de 20 anos ou mais.',
        },
        {
          question: 'Vocês cuidam da gestão da usina?',
          answer: 'Do desenvolvimento à operação, cuidamos de tudo: viabilidade técnica, projeto, instalação, monitoramento em tempo real e manutenção preditiva.',
        },
        {
          question: 'Qual a garantia dos painéis?',
          answer: 'Os painéis têm garantia de fábrica de 25 anos, protegendo o investimento por todo o contrato.',
        },
      ]}
    />
  </main>

  <FloatingWhatsApp />
  <CtaSection />
  <Footer />
</Layout>
