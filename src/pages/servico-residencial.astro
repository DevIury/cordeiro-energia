---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Energia Solar Residencial - Cordeiro Energia | Sistema Completo para Casas"
  description="Sistema de energia solar residencial com garantia de 25 anos. Economia de até 95% na conta de luz. Instalação profissional em Curvelo/MG."
>
  <Header />

  <main>
    <!-- Hero -->
    <section style="position:relative;min-height:70vh;display:flex;align-items:center;overflow:hidden;">
      <div style="position:absolute;inset:0;">
        <img src="/cat-casa.jpg" alt="Energia Solar Residencial" style="width:100%;height:100%;object-fit:cover;" />
        <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(10,10,10,0.85) 0%,rgba(10,10,10,0.5) 50%,rgba(244,89,43,0.3) 100%);"></div>
      </div>
      <div class="container" style="position:relative;z-index:2;padding:5rem 1.5rem 4rem;">
        <div style="display:inline-flex;align-items:center;gap:0.4rem;font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#fff;background:rgba(254,92,23,0.2);border:1px solid rgba(254,92,23,0.3);padding:0.5rem 1rem;border-radius:9999px;margin-bottom:2rem;backdrop-filter:blur(10px);">
          <svg style="width:0.75rem;height:0.75rem;" fill="currentColor" viewBox="0 0 24 24"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          Solução Residencial
        </div>
        <h1 style="font-size:3rem;font-weight:800;color:#fff;line-height:1.1;max-width:600px;margin-bottom:1.5rem;letter-spacing:-0.02em;">
          Energia Solar para <span style="color:#FE5C17;">Sua Casa</span>
        </h1>
        <p style="font-size:1.1rem;color:rgba(255,255,255,0.8);line-height:1.7;max-width:500px;margin-bottom:2.5rem;">
          Reduza sua conta de luz em até 95% com um sistema fotovoltaico profissional. Garantia de 25 anos, sem burocracia.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:1rem;">
          <a href="https://wa.me/5531999999999?text=Ol%C3%A1%2C%20gostaria%20de%20um%20or%C3%A7amento%20para%20energia%20solar%20residencial" style="display:inline-flex;align-items:center;gap:0.625rem;padding:1rem 2rem;background:#25D366;color:#fff;border-radius:9999px;font-size:1rem;font-weight:700;text-decoration:none;box-shadow:0 4px 20px rgba(37,211,102,0.35);transition:all 0.3s;" target="_blank" rel="noopener noreferrer">
            <svg style="width:1.25rem;height:1.25rem;" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            ORÇAMENTO GRÁTIS
          </a>
          <a href="#como-funciona" style="display:inline-flex;align-items:center;gap:0.5rem;padding:1rem 2rem;background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.25);border-radius:9999px;font-size:1rem;font-weight:600;text-decoration:none;backdrop-filter:blur(10px);transition:all 0.3s;">
            <svg style="width:1.125rem;height:1.125rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            COMO FUNCIONA
          </a>
        </div>
      </div>
    </section>

    <!-- Stats Bar -->
    <section style="background:#fff;padding:0;margin-top:-3rem;position:relative;z-index:3;">
      <div class="container">
        <div class="stats-bar" style="background:#fff;border-radius:1.25rem;border:1px solid #f0f0f0;box-shadow:0 10px 40px rgba(0,0,0,0.06);overflow:hidden;">
          <div style="text-align:center;padding:1.75rem 1rem;border-right:1px solid #f3f4f6;" class="stat-item">
            <div style="font-size:2rem;font-weight:800;color:#FE5C17;line-height:1;">95<span style="font-size:1rem;">%</span></div>
            <div style="font-size:0.75rem;color:#6b7280;margin-top:0.35rem;font-weight:500;">Economia máxima</div>
          </div>
          <div style="text-align:center;padding:1.75rem 1rem;border-right:1px solid #f3f4f6;" class="stat-item">
            <div style="font-size:2rem;font-weight:800;color:#FE5C17;line-height:1;">25<span style="font-size:1rem;"> anos</span></div>
            <div style="font-size:0.75rem;color:#6b7280;margin-top:0.35rem;font-weight:500;">Garantia</div>
          </div>
          <div style="text-align:center;padding:1.75rem 1rem;border-right:1px solid #f3f4f6;" class="stat-item">
            <div style="font-size:2rem;font-weight:800;color:#FE5C17;line-height:1;">R$400</div>
            <div style="font-size:0.75rem;color:#6b7280;margin-top:0.35rem;font-weight:500;">Economia/mês</div>
          </div>
          <div style="text-align:center;padding:1.75rem 1rem;" class="stat-item">
            <div style="font-size:2rem;font-weight:800;color:#FE5C17;line-height:1;">500<span style="font-size:1rem;">+</span></div>
            <div style="font-size:0.75rem;color:#6b7280;margin-top:0.35rem;font-weight:500;">Clientes atendidos</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benefícios -->
    <section style="padding:5rem 0;">
      <div class="container">
        <div class="section-header">
          <div class="tag">
            <svg style="width:0.75rem;height:0.75rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            VANTAGENS
          </div>
          <h2>Por que escolher <span>energia solar</span>?</h2>
          <p>Vantagens reais para sua família</p>
        </div>
        <div style="display:grid;gap:1.5rem;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));" class="benefits-grid">
          <div class="card benefit-card" style="padding:2rem;">
            <div class="benefit-icon">
              <svg style="width:1.5rem;height:1.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3>Economia de até 95%</h3>
            <p>Reduza drasticamente sua conta de luz. Em média, nossos clientes economizam R$ 400/mês.</p>
          </div>
          <div class="card benefit-card" style="padding:2rem;">
            <div class="benefit-icon">
              <svg style="width:1.5rem;height:1.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <h3>Garantia de 25 anos</h3>
            <p>Painéis com garantia de produção por 25 anos. Seu investimento está protegido.</p>
          </div>
          <div class="card benefit-card" style="padding:2rem;">
            <div class="benefit-icon">
              <svg style="width:1.5rem;height:1.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <h3>Monitoramento 24h</h3>
            <p>Acompanhe a geração do seu sistema em tempo real pelo aplicativo no celular.</p>
          </div>
          <div class="card benefit-card" style="padding:2rem;">
            <div class="benefit-icon">
              <svg style="width:1.5rem;height:1.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
            </div>
            <h3>Instalação Profissional</h3>
            <p>Equipe certificada com mais de 10 anos de experiência em sistemas fotovoltaicos.</p>
          </div>
          <div class="card benefit-card" style="padding:2rem;">
            <div class="benefit-icon">
              <svg style="width:1.5rem;height:1.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>
            <h3>Documentação Inclusa</h3>
            <p>Cuidamos de toda a parte burocrática: projeto, aprovação, ligação na rede.</p>
          </div>
          <div class="card benefit-card" style="padding:2rem;">
            <div class="benefit-icon">
              <svg style="width:1.5rem;height:1.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
            </div>
            <h3>Sem Investimento Inicial</h3>
            <p>Facilidades de pagamento e financiamento para você começar a economizar hoje.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Como Funciona -->
    <section id="como-funciona" style="padding:5rem 0;background:linear-gradient(180deg,#f9fafb 0%,#fff 100%);">
      <div class="container">
        <div class="section-header">
          <div class="tag">
            <svg style="width:0.75rem;height:0.75rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            PROCESSO
          </div>
          <h2>Como <span>funciona</span></h2>
          <p>Do primeiro contato até a economia na sua conta</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:2rem;position:relative;" class="steps-grid">
          <!-- Connecting line -->
          <div style="position:absolute;top:3rem;left:10%;right:10%;height:2px;background:linear-gradient(90deg,transparent,rgba(254,92,23,0.2),rgba(254,92,23,0.2),transparent);display:none;" class="step-line"></div>

          <div class="step-card scroll-reveal">
            <div class="step-number">1</div>
            <div class="step-icon-wrap">
              <svg style="width:1.5rem;height:1.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            </div>
            <h3>Consulta Grátis</h3>
            <p>Analisamos seu consumo e apresentamos a melhor solução para sua residência.</p>
          </div>
          <div class="step-card scroll-reveal" style="transition-delay:100ms;">
            <div class="step-number">2</div>
            <div class="step-icon-wrap">
              <svg style="width:1.5rem;height:1.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            </div>
            <h3>Projeto Personalizado</h3>
            <p>Projetamos o sistema ideal para o consumo e as características da sua casa.</p>
          </div>
          <div class="step-card scroll-reveal" style="transition-delay:200ms;">
            <div class="step-number">3</div>
            <div class="step-icon-wrap">
              <svg style="width:1.5rem;height:1.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3>Aprovação e Documentação</h3>
            <p>Cuidamos de todo o processo burocrático junto à concessionária.</p>
          </div>
          <div class="step-card scroll-reveal" style="transition-delay:300ms;">
            <div class="step-number">4</div>
            <div class="step-icon-wrap">
              <svg style="width:1.5rem;height:1.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h3>Instalação Rápida</h3>
            <p>Instalação profissional em até 3 dias. Você começa a economizar imediatamente.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section style="padding:5rem 0;">
      <div class="container" style="max-width:700px;margin:0 auto;">
        <div class="section-header">
          <div class="tag">
            <svg style="width:0.75rem;height:0.75rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            PERGUNTAS FREQUENTES
          </div>
          <h2>Dúvidas <span>frequentes</span></h2>
        </div>
        <div class="faq-list">
          <div class="faq-item">
            <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
              <span>Quanto custa instalar energia solar?</span>
              <svg class="faq-arrow" style="width:1.25rem;height:1.25rem;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="faq-answer">
              <p>O investimento varia conforme o consumo da residência. Oferecemos opções de financiamento em até 60x e também opção sem entrada. O payback médio é de 3 a 5 anos.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
              <span>Qual o payback do sistema?</span>
              <svg class="faq-arrow" style="width:1.25rem;height:1.25rem;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="faq-answer">
              <p>O payback médio é de 3 a 5 anos. Depois disso, a energia gerada é 100% gratuita por mais 20 anos, considerando a garantia de 25 anos dos painéis.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
              <span>Preciso de baterias?</span>
              <svg class="faq-arrow" style="width:1.25rem;height:1.25rem;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="faq-answer">
              <p>Não necessariamente. O sistema on-grid (mais comum) usa a rede da concessionária como "bateria". Baterias são indicadas para quem quer autonomia total ou tem quedas frequentes de energia.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
              <span>E se estiver nublado ou chovendo?</span>
              <svg class="faq-arrow" style="width:1.25rem;height:1.25rem;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="faq-answer">
              <p>Os painéis geram energia mesmo em dias nublados, porém com menor eficiência. Além disso, os créditos acumulados nos meses de sol compensam os períodos de menor produção.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <CtaSection />
  </main>

  <FloatingWhatsApp />
  <Footer />
</Layout>

<style>
  /* Benefits */
  .benefits-grid { grid-template-columns: repeat(1, 1fr); }
  @media (min-width: 640px) { .benefits-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .benefits-grid { grid-template-columns: repeat(3, 1fr); } }

  .benefit-card {
    padding: 2rem !important;
    text-align: center;
  }
  .benefit-icon {
    width: 3.5rem;
    height: 3.5rem;
    background: linear-gradient(135deg, rgba(254,92,23,0.12), rgba(254,92,23,0.04));
    border-radius: 0.875rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FE5C17;
    margin: 0 auto 1.25rem;
    transition: all 0.4s cubic-bezier(0.22,0.61,0.36,1);
  }
  .benefit-card:hover .benefit-icon {
    background: linear-gradient(135deg, #FE5C17, #FF8F00);
    color: #fff;
    transform: scale(1.1) rotate(5deg);
    box-shadow: 0 8px 25px rgba(254,92,23,0.3);
  }
  .benefit-card h3 { font-size: 1.05rem; font-weight: 700; color: #111; margin-bottom: 0.5rem; }
  .benefit-card p { color: #6b7280; font-size: 0.875rem; line-height: 1.65; }

  /* Steps */
  .steps-grid { grid-template-columns: repeat(1, 1fr); }
  @media (min-width: 640px) { .steps-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .steps-grid { grid-template-columns: repeat(4, 1fr); } }
  @media (min-width: 1024px) { .step-line { display: block !important; } }

  .step-card {
    text-align: center;
    padding: 2rem 1.5rem;
    border-radius: 1rem;
    background: #fff;
    border: 1px solid #f3f4f6;
    position: relative;
    transition: all 0.4s cubic-bezier(0.22,0.61,0.36,1);
  }
  .step-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 15px 40px rgba(254,92,23,0.08);
    border-color: rgba(254,92,23,0.15);
  }
  .step-number {
    width: 2.25rem;
    height: 2.25rem;
    background: linear-gradient(135deg, #FE5C17, #FF8F00);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 800;
    margin: 0 auto 1rem;
    box-shadow: 0 4px 12px rgba(254,92,23,0.25);
  }
  .step-icon-wrap {
    width: 3rem;
    height: 3rem;
    background: rgba(254,92,23,0.08);
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FE5C17;
    margin: 0 auto 1rem;
    transition: all 0.3s;
  }
  .step-card:hover .step-icon-wrap {
