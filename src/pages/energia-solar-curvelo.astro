---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import CtaSection from '../components/CtaSection.astro';
import Analytics from '../components/Analytics.astro';

const city = 'Curvelo';
const state = 'MG';
---

<Layout
  title={`Energia Solar em ${city} ${state} - Cordeiro Energia | Orçamento Grátis`}
  description={`Instalação de energia solar em ${city} ${state}. Economize até 95% na conta de luz. Orçamento grátis pelo WhatsApp. Atendemos toda a região de ${city}.`}
  ogImage="/og-image.svg"
>
  <Header />

  <main>
    <!-- Hero -->
    <section class="py-16 md:py-24 bg-gradient-to-b from-dark to-white/[0.02]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
          <div>
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-500/10 border border-brand-500/20 mb-6">
              <span class="w-2 h-2 rounded-full bg-eco-500 animate-pulse"></span>
              <span class="text-sm text-brand-500 font-medium">Atendemos {city} e região</span>
            </div>

            <h1 class="text-4xl md:text-5xl font-bold text-dark leading-tight mb-6">
              Energia Solar em
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-500 to-eco-500">
                {city} {state}
              </span>
            </h1>

            <p class="text-lg text-gray-600 mb-8">
              Transforme a luz do sol em economia para sua residência ou empresa em {city}. Sistemas de energia solar com garantia de 25 anos e monitoramento 24h.
            </p>

            <div class="flex flex-col sm:flex-row items-center gap-4">
              <a
                href="https://wa.me/5538997350343?text=Ol%C3%A1%2C%20gostaria%20de%20um%20or%C3%A7amento%20para%20energia%20solar%20em%20Curvelo"
                class="btn-solar text-lg w-full sm:w-auto justify-center"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                </svg>
                Orçamento Grátis
              </a>
              <a href="tel:+5538997350343" class="btn-eco text-lg w-full sm:w-auto justify-center">
                📞 Ligar Agora
              </a>
            </div>
          </div>

          <div class="hidden md:flex items-center justify-center">
            <div class="relative">
              <div class="w-72 h-72 rounded-full bg-gradient-to-br from-brand-500/20 to-eco-500/20 flex items-center justify-center">
                <div class="w-56 h-56 rounded-full bg-gradient-to-br from-brand-500/30 to-eco-500/30 flex items-center justify-center">
                  <div class="w-40 h-40 rounded-full bg-gradient-to-br from-brand-500 to-eco-500 flex items-center justify-center shadow-2xl shadow-brand-500/30">
                    <span class="text-4xl">☀️</span>
                  </div>
                </div>
              </div>
              <div class="absolute -top-4 -right-4 bg-dark/90 backdrop-blur-sm rounded-2xl p-4 border border-white/10 shadow-xl">
                <div class="text-2xl font-bold text-eco-500">5.5 kWh</div>
                <div class="text-xs text-gray-600">irradiação solar/dia</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits for Curvelo -->
    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 scroll-reveal">
          <h2 class="text-3xl md:text-4xl font-bold text-dark mb-4">
            Por que energia solar em <span class="text-brand-500">{city}</span>?
          </h2>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          <div class="scroll-reveal bg-gray-50 rounded-2xl p-6 border border-white/5">
            <div class="text-3xl mb-4">☀️</div>
            <h3 class="text-lg font-bold text-dark mb-2">Alta irradiação solar</h3>
            <p class="text-gray-600 text-sm">{city} possui mais de 3.200 horas de sol por ano, ideal para geração de energia.</p>
          </div>
          <div class="scroll-reveal bg-gray-50 rounded-2xl p-6 border border-white/5">
            <div class="text-3xl mb-4">💰</div>
            <h3 class="text-lg font-bold text-dark mb-2">Economia garantida</h3>
            <p class="text-gray-600 text-sm">Reduza sua conta de luz em até 95% com um sistema bem dimensionado.</p>
          </div>
          <div class="scroll-reveal bg-gray-50 rounded-2xl p-6 border border-white/5">
            <div class="text-3xl mb-4">📈</div>
            <h3 class="text-lg font-bold text-dark mb-2">Tarifas crescentes</h3>
            <p class="text-gray-600 text-sm">Proteja-se dos reajustes anuais da energia elétrica com energia limpa.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Costs -->
    <section class="py-16 md:py-24 bg-white/[0.02]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 scroll-reveal">
          <h2 class="text-3xl md:text-4xl font-bold text-dark mb-4">
            Custos de energia solar em <span class="text-brand-500">{city}</span>
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Investimento acessível com retorno rápido. Veja os valores aproximados:
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 max-w-5xl mx-auto">
          <div class="scroll-reveal bg-gray-50 rounded-2xl p-6 border border-white/5 text-center">
            <div class="text-sm text-gray-600 mb-2">Residências pequenas</div>
            <div class="text-2xl font-bold text-brand-500 mb-1">R$ 12.000 - R$ 18.000</div>
            <div class="text-xs text-gray-500">Até 300 kWh/mês</div>
          </div>
          <div class="scroll-reveal bg-gray-50 rounded-2xl p-6 border border-white/5 text-center">
            <div class="text-sm text-gray-600 mb-2">Residências médias</div>
            <div class="text-2xl font-bold text-brand-500 mb-1">R$ 18.000 - R$ 30.000</div>
            <div class="text-xs text-gray-500">300-600 kWh/mês</div>
          </div>
          <div class="scroll-reveal bg-gray-50 rounded-2xl p-6 border border-white/5 text-center">
            <div class="text-sm text-gray-600 mb-2">Residências grandes</div>
            <div class="text-2xl font-bold text-brand-500 mb-1">R$ 30.000 - R$ 50.000</div>
            <div class="text-xs text-gray-500">Acima de 600 kWh/mês</div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 md:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 scroll-reveal">
          <h2 class="text-3xl md:text-4xl font-bold text-dark">
            Perguntas frequentes sobre energia solar em <span class="text-brand-500">{city}</span>
          </h2>
        </div>

        <div class="space-y-4">
          <details class="scroll-reveal bg-gray-50 rounded-2xl border border-white/5 overflow-hidden group">
            <summary class="flex items-center justify-between p-6 cursor-pointer text-dark font-medium hover:text-brand-500 transition-colors list-none">
              Quanto custa instalar energia solar em {city}?
              <svg class="w-5 h-5 text-gray-600 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-6 text-gray-600 text-sm leading-relaxed">
              O investimento varia conforme o consumo. Para uma residência que gasta R$ 400/mês, o custo é de aproximadamente R$ 20.000 a R$ 25.000. Com a economia mensal de cerca de R$ 380, o payback ocorre em 4 a 5 anos.
            </div>
          </details>

          <details class="scroll-reveal bg-gray-50 rounded-2xl border border-white/5 overflow-hidden group">
            <summary class="flex items-center justify-between p-6 cursor-pointer text-dark font-medium hover:text-brand-500 transition-colors list-none">
              A energia solar funciona bem em {city}?
              <svg class="w-5 h-5 text-gray-600 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-6 text-gray-600 text-sm leading-relaxed">
              Sim! {city} possui uma das melhores irradiações solares de Minas Gerais, com média de 5.5 kWh/m²/dia. Isso significa alta eficiência e payback mais rápido do investimento.
            </div>
          </details>

          <details class="scroll-reveal bg-gray-50 rounded-2xl border border-white/5 overflow-hidden group">
            <summary class="flex items-center justify-between p-6 cursor-pointer text-dark font-medium hover:text-brand-500 transition-colors list-none">
              Preciso de autorização da prefeitura de {city}?
              <svg class="w-5 h-5 text-gray-600 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-6 text-gray-600 text-sm leading-relaxed">
              Sim, é necessário registrar o sistema na prefeitura e na concessionária local. Cuidamos de toda a documentação para você, incluindo o alvará e o registro na CELF.
            </div>
          </details>
        </div>
      </div>
    </section>

    <CtaSection />
  </main>

  <FloatingWhatsApp />
  <Footer />
  <Analytics />
</Layout>
