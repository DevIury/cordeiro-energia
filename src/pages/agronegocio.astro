---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
import FaqItem from '../components/FaqItem.astro';
---

<Layout
  title="Energia Solar para Agronegócio - Cordeiro Energia | Rural e Agroindústria"
  description="Soluções de energia solar para propriedades rurais e agroindústrias. Irrigação, frigoríficos, celeiros. Economia real no campo."
>
  <Header />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Posso usar energia solar para irrigação?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sim! Sistemas de bomba solar são ideais para irrigação, eliminando o custo com diesel ou energia da rede em áreas remotas."
        }
      },
      {
        "@type": "Question",
        "name": "O sistema funciona em áreas sem rede elétrica?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sim! Sistemas off-grid com baterias permitem completo funcionamento independente da rede de distribuição."
        }
      },
      {
        "@type": "Question",
        "name": "Tem incentivo para produtores rurais?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sim! O PRONAF Linha Verde oferece financiamento com juros baixos para sistemas solares em propriedades rurais."
        }
      }
    ]
  })} />

  <main>
    <!-- Hero -->
    <section style="position:relative;min-height:70vh;display:flex;align-items:center;overflow:hidden;">
      <div style="position:absolute;inset:0;">
        <img src="/cat-agro.webp" alt="Energia solar agronegócio" fetchpriority="high" style="width:100%;height:100%;object-fit:cover;" />
        <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(0,0,0,0.8) 0%,rgba(0,0,0,0.6) 50%,rgba(254,92,23,0.4) 100%);"></div>
      </div>
      <div style="position:relative;z-index:10;max-width:1200px;margin:0 auto;padding:2rem;width:100%;">
        <div style="display:inline-flex;align-items:center;gap:0.5rem;background:rgba(254,92,23,0.15);border:1px solid rgba(254,92,23,0.3);border-radius:9999px;padding:0.5rem 1.25rem;margin-bottom:1.5rem;">
          <svg style="width:1rem;height:1rem;" fill="currentColor" viewBox="0 0 24 24"><path d="M12 22c4.97 0 9-4.03 9-9-4.97 0-9 4.03-9 9zM5.6 10.25c0 1.38 1.12 2.5 2.5 2.5.53 0 1.01-.16 1.42-.44l-.02.19c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5l-.02-.19c.4.28.89.44 1.42.44 1.38 0 2.5-1.12 2.5-2.5 0-1-.59-1.85-1.43-2.25.84-.4 1.43-1.25 1.43-2.25 0-1.38-1.12-2.5-2.5-2.5-.53 0-1.01.16-1.42.44l.02-.19C14.5 2.12 13.38 1 12 1S9.5 2.12 9.5 3.5l.02.19c-.4-.28-.89-.44-1.42-.44-1.38 0-2.5 1.12-2.5 2.5 0 1 .59 1.85 1.43 2.25-.84.4-1.43 1.25-1.43 2.25zM12 5.5c1.38 0 2.5 1.12 2.5 2.5s-1.12 2.5-2.5 2.5S9.5 9.38 9.5 8s1.12-2.5 2.5-2.5zM3 13c0 4.97 4.03 9 9 9-4.97 0-9-4.03-9-9z"/></svg>
          <span style="color:#FE5C17;font-size:0.8rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;">Solução Rural</span>
        </div>
        <h1 style="font-size:clamp(2rem,5vw,3.5rem);font-weight:800;color:#fff;line-height:1.1;margin-bottom:1.5rem;">
          Energia Solar <span style="color:#FE5C17;">para o Campo</span>
        </h1>
        <p style="font-size:1.1rem;color:rgba(255,255,255,0.8);max-width:600px;line-height:1.7;margin-bottom:2rem;">
          Soluções energéticas sob medida para propriedades rurais, agroindústrias e sistemas de irrigação. Economia que faz a diferença no campo.
        </p>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
          <a href="https://wa.me/5538997350343?text=Ol%C3%A1%2C%20tenho%20uma%20propriedade%20rural%20e%20gostaria%20de%20energia%20solar" target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:0.5rem;background:#25D366;color:#fff;padding:1rem 2rem;border-radius:12px;font-weight:700;font-size:1rem;text-decoration:none;transition:all 0.3s ease;box-shadow:0 4px 15px rgba(37,211,102,0.4);">
            <svg style="width:1.25rem;height:1.25rem;" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            SOLICITAR ANÁLISE
          </a>
          <a href="#solucoes" style="display:inline-flex;align-items:center;gap:0.5rem;background:transparent;color:#fff;border:2px solid rgba(255,255,255,0.3);padding:1rem 2rem;border-radius:12px;font-weight:700;font-size:1rem;text-decoration:none;transition:all 0.3s ease;">
            SOLUÇÕES
          </a>
        </div>
      </div>
    </section>

    <!-- Soluções -->
    <section id="solucoes" style="padding:5rem 0;">
      <div style="max-width:1200px;margin:0 auto;padding:0 1.5rem;">
        <div style="text-align:center;margin-bottom:3rem;">
          <div style="display:inline-flex;align-items:center;gap:0.5rem;background:rgba(254,92,23,0.1);border:1px solid rgba(254,92,23,0.2);border-radius:9999px;padding:0.4rem 1rem;margin-bottom:1rem;">
