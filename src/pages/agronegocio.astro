          <div style="display:inline-flex;align-items:center;gap:0.5rem;background:rgba(254,92,23,0.1);border:1px solid rgba(254,92,23,0.2);border-radius:9999px;padding:0.4rem 1rem;margin-bottom:1rem;">
            <svg style="width:0.75rem;height:0.75rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span style="color:#FE5C17;font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;">VANTAGENS</span>
