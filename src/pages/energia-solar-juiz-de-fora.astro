---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import CtaSection from '../components/CtaSection.astro';
import FaqItem from '../components/FaqItem.astro';

const city = 'Juiz de Fora';
const state = 'MG';
---

<Layout
  title={`Energia Solar em ${city} ${state} - Cordeiro Energia | Orçamento Grátis`}
  description={`Instalação de energia solar em ${city} ${state}. Economize até 95% na conta de luz. Orçamento grátis pelo WhatsApp.`}
  ogImage="/og-image.svg"
  geoCity={city}
>
  <Header />

  <main>
    <section class="hero" style="min-height:70vh;">
      <div class="hero-bg">
        <img src="/hero-solar.webp" alt="Energia solar em Juiz de Fora" fetchpriority="high" />
        <div class="hero-overlay"></div>
      </div>
      <div class="container hero-content">
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          Atendemos {city} e Zona da Mata
        </div>
        <h1 style="font-size:2.5rem;">Energia Solar em <span>{city}</span></h1>
        <p>{city}, importante centro econômico de Minas Gerais, oferece excelente irradiância solar. Residências e empresas podem economizar até 95% na conta de luz.</p>
        <div class="hero-btns">
          <a href="https://wa.me/5538997350343?text=Ol%C3%A1%2C%20gostaria%20de%20um%20or%C3%A7amento%20para%20energia%20solar%20em%20Juiz%20de%20Fora" class="btn btn-orange btn-xl" target="_blank" rel="noopener noreferrer">
            <svg style="width:1rem;height:1rem;" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            ORÇAMENTO GRÁTIS
          </a>
          <a href="tel:+5538997350343" class="btn btn-outline btn-xl">📞 LIGAR AGORA</a>
        </div>
      </div>
    </section>

    <section style="padding:5rem 0;">
      <div class="container">
        <div class="section-header">
          <div class="tag">
            <svg style="width:0.75rem;height:0.75rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            VANTAGENS
          </div>
          <h2>Energia solar para empresas em <span>{city}</span></h2>
        </div>
        <div style="display:grid;gap:1.5rem;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));">
          <div class="card" style="padding:2rem;text-align:center;">
            <div style="font-size:2.5rem;margin-bottom:1rem;">🏭</div>
            <h3 style="font-size:1.05rem;font-weight:700;color:#111;margin-bottom:0.5rem;">Indústrias</h3>
            <p style="color:#6b7280;font-size:0.9rem;line-height:1.6;">Grandes potências para indústrias com alto consumo. Sistemas de até 5MW com monitoramento 24h.</p>
          </div>
          <div class="card" style="padding:2rem;text-align:center;">
            <div style="font-size:2.5rem;margin-bottom:1rem;">🏢</div>
            <h3 style="font-size:1.05rem;font-weight:700;color:#111;margin-bottom:0.5rem;">Comércios</h3>
            <p style="color:#6b7280;font-size:0.9rem;line-height:1.6;">Lojas, shoppings e escritórios economizam até 95% na conta de luz com energia solar.</p>
          </div>
          <div class="card" style="padding:2rem;text-align:center;">
            <div style="font-size:2.5rem;margin-bottom:1rem;">🏠</div>
            <h3 style="font-size:1.05rem;font-weight:700;color:#111;margin-bottom:0.5rem;">Residências</h3>
            <p style="color:#6b7280;font-size:0.9rem;line-height:1.6;">Casas e apartamentos com economia de até 95% na conta de luz. Payback em 4 a 6 anos.</p>
          </div>
        </div>
      </div>
    </section>

    <section style="padding:5rem 0;background:#f9fafb;">
      <div class="container" style="max-width:700px;margin:0 auto;">
        <div class="section-header">
          <div class="tag">
            <svg style="width:0.75rem;height:0.75rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            PERGUNTAS FREQUENTES
          </div>
          <h2>Dúvidas <span>frequentes</span></h2>
        </div>
        <div class="faq-list">
          <FaqItem
            question={`Qual o custo de energia solar para empresas em ${city}?`}
            answer={`O investimento para empresas em ${city} varia conforme o consumo. Sistemas de 30kWp a 500kWp são comuns, com payback de 3 a 5 anos.`}
          />
          <FaqItem
            question="É possível vender a energia excedente?"
            answer="Sim! Empresas podem participar de leilões de energia e vender sua energia excedente, gerando uma receita adicional."
          />
        </div>
      </div>
    </section>

    <CtaSection />
  </main>

  <FloatingWhatsApp />
  <Footer />
</Layout>

<style>
  .pulse-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: #00E676;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
</style>
