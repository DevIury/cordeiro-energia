<footer style="background:linear-gradient(135deg,#7a1f05 0%,#c0390b 20%,#f4592b 45%,#ff8a50 70%,#ffab76 90%,#f4592b 100%);color:#fff;position:relative;overflow:hidden;">
  <!-- Decorative elements -->
