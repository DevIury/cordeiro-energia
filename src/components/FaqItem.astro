---
interface Props {
  question: string;
  answer: string;
  n?: string;
}

const { question, answer, n } = Astro.props;

const slug = question.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 48);
const panelId = `faq-${slug || Math.random().toString(36).slice(2, 8)}`;
---

<div class="faq-item" data-faq>
  <button class="faq-question" type="button" aria-expanded="false" aria-controls={panelId} data-faq-btn>
    <span class="faq-main">
      {n && <span class="faq-idx" aria-hidden="true">{n}</span>}
      <span class="faq-q">{question}</span>
    </span>
    <span class="faq-icon" aria-hidden="true">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
    </span>
  </button>
  <div class="faq-answer" id={panelId}>
    <div class="faq-answer-inner">
      <p set:html={answer} />
    </div>
  </div>
</div>

<style>
  .faq-item {
    position: relative; background: #fff; border: 1px solid rgba(10, 14, 23, 0.07);
    border-radius: 1rem; overflow: hidden;
    transition: background-color 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, transform 0.4s ease;
  }
  .faq-item:hover { border-color: rgba(254, 92, 23, 0.35); box-shadow: 0 16px 34px rgba(10, 14, 23, 0.08); transform: translateY(-2px); }
  .faq-item.open {
    background: #0a0e17; border-color: rgba(255, 194, 77, 0.4); transform: none;
    box-shadow: 0 28px 60px rgba(10, 14, 23, 0.3);
  }

  .faq-question {
    width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1.3rem 1.35rem; background: none; border: 0; cursor: pointer; text-align: left;
    font-family: inherit; font-size: clamp(1rem, 1.15vw, 1.08rem); font-weight: 700;
    line-height: 1.4; letter-spacing: -0.01em; color: #111;
    transition: color 0.3s;
  }
  .faq-item.open .faq-question { color: #fff; }
  .faq-question:focus-visible { outline: 2px solid #fe5c17; outline-offset: -4px; border-radius: 1rem; }
  .faq-main { display: flex; align-items: baseline; gap: 0.85rem; flex: 1; min-width: 0; }
  .faq-idx { font-size: 0.68rem; letter-spacing: 0.14em; color: #fe5c17; flex-shrink: 0; transition: color 0.3s; }
  .faq-item.open .faq-idx { color: #ffc24d; }
  .faq-q { flex: 1; }

  .faq-icon {
    width: 2.35rem; height: 2.35rem; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(254, 92, 23, 0.1); color: #fe5c17; border: 1px solid rgba(254, 92, 23, 0.3);
    transition: transform 0.45s cubic-bezier(0.65, 0, 0.2, 1), background-color 0.35s, color 0.35s, border-color 0.35s;
  }
  .faq-icon svg { width: 1.05rem; height: 1.05rem; }
  .faq-item.open .faq-icon { background: #fe5c17; border-color: #fe5c17; color: #fff; transform: rotate(45deg); }

  .faq-answer {
    display: grid; grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.65, 0, 0.2, 1);
  }
  .faq-item.open .faq-answer { grid-template-rows: 1fr; }
  .faq-answer-inner { overflow: hidden; min-height: 0; }
  .faq-answer-inner p {
    margin: 0 0 0 1.35rem; padding: 0.15rem 1.5rem 1.5rem 1.1rem;
    font-size: 0.95rem; line-height: 1.75; color: #a8b0bd;
    border-left: 2px solid rgba(255, 194, 77, 0.45);
  }
  .faq-item:has(.faq-idx) .faq-answer-inner p { margin-left: 3.5rem; }
  .faq-answer :global(strong) { color: #ffc24d; font-weight: 700; }

  @media (prefers-reduced-motion: reduce) {
    .faq-item, .faq-icon, .faq-answer { transition: none; }
    .faq-item:hover { transform: none; }
  }
</style>

<script>
  document.addEventListener('click', (ev) => {
    const el = ev.target as HTMLElement | null;
    const btn = el?.closest('[data-faq-btn]');
    if (!(btn instanceof HTMLButtonElement)) return;

    const item = btn.closest('[data-faq]');
    if (!(item instanceof HTMLElement)) return;

    const willOpen = !item.classList.contains('open');

    item.parentElement?.querySelectorAll<HTMLElement>('[data-faq].open').forEach((other) => {
      if (other === item) return;
      other.classList.remove('open');
      other.querySelector('[data-faq-btn]')?.setAttribute('aria-expanded', 'false');
    });

    item.classList.toggle('open', willOpen);
    btn.setAttribute('aria-expanded', String(willOpen));
  });
</script>
