---
const navLinks = [
  { href: '/', label: 'Início', section: 'hero' },
  { href: '/#sobre', label: 'Sobre', section: 'sobre' },
  { href: '/#servicos', label: 'Serviços', section: 'servicos' },
  { href: '/#portfolio', label: 'Projetos', section: 'portfolio' },
  { href: '/blog', label: 'Blog', section: 'blog' },
  { href: '/#contato', label: 'Contato', section: 'contato' },
];

const currentPath = Astro.url.pathname;
---

<!-- Top accent bar -->
<div style="height:3px;background:linear-gradient(90deg,#FE5C17 0%,#FFC107 50%,#FE5C17 100%);position:fixed;top:0;left:0;right:0;z-index:51;"></div>

<nav class="fixed top-[3px] left-0 right-0 z-50" id="nav">
  <div class="nav-inner">
    <div class="container nav-row">
      <a href="/" class="logo-link">
        <img src="/logo.png" alt="Cordeiro Energia" style="height:2.75rem;" />
      </a>

      <!-- Desktop nav -->
      <div class="nav-desktop">
        {navLinks.map((link) => (
          <a href={link.href} class:list={['nav-link', currentPath === link.href && 'nav-link-active']} data-section={link.section}>
            {link.label}
          </a>
        ))}
      </div>

      <div class="nav-right">
        <a
          href="https://wa.me/5538997350343?text=Ol%C3%A1%2C%20gostaria%20de%20um%20or%C3%A7amento%20para%20energia%20solar"
          class="btn btn-orange nav-cta-btn"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg style="width:1.125rem;height:1.125rem;" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Fale Conosco
        </a>

        <!-- Mobile hamburger -->
        <button
          id="hamburger"
          class="hamburger"
          aria-label="Abrir menu"
          aria-expanded="false"
          aria-controls="navLinks"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile sidebar (outside nav for proper z-index) -->
<div id="navLinks" class="nav-links">
  <div class="nav-mobile-top">
    <a href="/" class="logo-link">
      <img src="/logo.png" alt="Cordeiro Energia" style="height:2rem;" />
    </a>
    <button id="navClose" class="nav-close" aria-label="Fechar menu">
      <svg style="width:1.25rem;height:1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="nav-mobile-links">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class:list={['nav-mobile-link', currentPath === link.href && 'nav-mobile-link-active']}
        data-section={link.section}
      >
        <span>{link.label}</span>
        <svg style="width:0.875rem;height:0.875rem;opacity:0.3;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    ))}
  </nav>

  <div class="nav-mobile-bottom">
    <a
      href="https://wa.me/5538997350343?text=Ol%C3%A1%2C%20gostaria%20de%20um%20or%C3%A7amento%20para%20energia%20solar"
      class="btn btn-orange"
      style="width:100%;justify-content:center;"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg style="width:1.1rem;height:1.1rem;" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      FALE COM UM ESPECIALISTA
    </a>
    <div class="nav-mobile-contact">
      <a href="tel:+5538997350343">
        <svg style="width:1rem;height:1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        (31) 99999-9999
      </a>
    </div>
  </div>
</div>

<!-- Overlay -->
<div class="nav-overlay" id="navOverlay"></div>

<!-- Spacer -->
<div style="height:calc(4.5rem + 3px);"></div>

<style>
  /* === NAV BAR === */
  .nav-inner {
    background: rgba(255,255,255,0.88);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border-bottom: 1px solid rgba(0,0,0,0.06);
    transition: box-shadow 0.4s, background 0.3s;
  }
  .nav-inner.scrolled {
    background: rgba(255,255,255,0.95);
    box-shadow: 0 4px 30px rgba(0,0,0,0.06);
  }
  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.5rem;
    gap: 2rem;
  }
  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 0.2s;
  }
  .logo-link:hover { opacity: 0.85; }

  /* === DESKTOP NAV === */
  .nav-desktop { display: none; }
  @media (min-width: 768px) {
    .nav-desktop { display: flex; align-items: center; gap: 0.125rem; }
  }
  .nav-link {
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    color: #4b5563;
    padding: 0.625rem 1rem;
    border-radius: 0.625rem;
    transition: color 0.2s, background 0.2s;
    position: relative;
    letter-spacing: -0.01em;
  }
  .nav-link:hover {
    color: #FE5C17;
    background: rgba(254,92,23,0.07);
  }
  .nav-link-active {
    color: #FE5C17;
    font-weight: 700;
  }
  .nav-link-active::after {
    content: '';
    position: absolute;
    bottom: 0.15rem;
    left: 50%;
    transform: translateX(-50%);
    width: 1.5rem;
    height: 2.5px;
    background: linear-gradient(90deg, #FE5C17, #FFC107);
    border-radius: 2px;
  }

  /* === CTA BUTTON === */
  .nav-right { display: flex; align-items: center; gap: 0.75rem; }
  .nav-cta-btn {
    white-space: nowrap;
    padding: 0.75rem 1.5rem;
    font-size: 0.9rem;
    border-radius: 9999px;
    box-shadow: 0 4px 15px rgba(254,92,23,0.25);
  }
  .nav-cta-btn:hover {
    box-shadow: 0 6px 25px rgba(254,92,23,0.35);
    transform: translateY(-1px);
  }
  @media (max-width: 767px) {
    .nav-cta-btn { display: none !important; }
  }

  /* === HAMBURGER === */
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 3rem;
    height: 3rem;
    background: #f9fafb;
    border: 1.5px solid #e5e7eb;
    border-radius: 0.75rem;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .hamburger:hover {
    background: #fff;
    border-color: #FE5C17;
    box-shadow: 0 2px 12px rgba(254,92,23,0.12);
  }
  .hamburger span {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: #374151;
    border-radius: 2px;
    transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
  }
  .hamburger.active span:nth-child(1) { transform: rotate(45deg) translate(5px,5px); background: #FE5C17; }
  .hamburger.active span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .hamburger.active span:nth-child(3) { transform: rotate(-45deg) translate(5px,-5px); background: #FE5C17; }

  @media (min-width: 768px) {
    .hamburger { display: none; }
  }

  /* === MOBILE SIDEBAR === */
  .nav-links {
    position: fixed;
    top: 0;
    right: 0;
    width: min(85vw, 380px);
    height: 100dvh;
    background: #fff;
    z-index: 200;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.22,0.61,0.36,1);
    box-shadow: -10px 0 50px rgba(0,0,0,0.15);
  }
  .nav-links.open { transform: translateX(0); }

  .nav-mobile-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid #f3f4f6;
    flex-shrink: 0;
  }
  .nav-close {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f9fafb;
    border: 1.5px solid #e5e7eb;
    color: #6b7280;
    cursor: pointer;
    border-radius: 0.625rem;
    transition: all 0.2s;
  }
  .nav-close:hover { color: #FE5C17; background: #fff5ed; border-color: #FE5C17; }

  .nav-mobile-links {
    flex: 1;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    overflow-y: auto;
  }
  .nav-mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.125rem;
    border-radius: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    color: #374151;
    text-decoration: none;
    transition: all 0.2s;
    letter-spacing: -0.01em;
  }
  .nav-mobile-link:hover {
    background: linear-gradient(135deg, rgba(254,92,23,0.08), rgba(254,92,23,0.02));
    color: #FE5C17;
    padding-left: 1.375rem;
  }
  .nav-mobile-link-active {
    color: #FE5C17;
    font-weight: 700;
    background: rgba(254,92,23,0.07);
  }

  .nav-mobile-bottom {
    padding: 1.25rem 1.5rem;
    border-top: 1px solid #f3f4f6;
    flex-shrink: 0;
    background: #fafafa;
  }
  .nav-mobile-contact {
    margin-top: 0.875rem;
    text-align: center;
  }
  .nav-mobile-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #6b7280;
    text-decoration: none;
    transition: color 0.2s;
    font-weight: 500;
  }
  .nav-mobile-contact a:hover { color: #FE5C17; }

  /* === OVERLAY === */
  .nav-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 150;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s;
  }
  .nav-overlay.active {
    opacity: 1;
    pointer-events: all;
  }
</style>

<script>
  function initNav() {
    const hamburger = document.getElementById('hamburger');
    const navLinks = document.getElementById('navLinks');
    const navClose = document.getElementById('navClose');
    const navOverlay = document.getElementById('navOverlay');
    const navInner = document.querySelector('.nav-inner');

    if (!hamburger || !navLinks || !navClose) return;

    function openMenu() {
      navLinks.classList.add('open');
      hamburger.classList.add('active');
      hamburger.setAttribute('aria-expanded', 'true');
      document.body.classList.add('sidebar-open');
      if (navOverlay) navOverlay.classList.add('active');
    }

    function closeMenu() {
      navLinks.classList.remove('open');
      hamburger.classList.remove('active');
      hamburger.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('sidebar-open');
      if (navOverlay) navOverlay.classList.remove('active');
    }

    hamburger.addEventListener('click', () => {
      const isOpen = navLinks.classList.contains('open');
      if (isOpen) closeMenu();
      else openMenu();
    });

    navClose.addEventListener('click', closeMenu);
    if (navOverlay) navOverlay.addEventListener('click', closeMenu);

    navLinks.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });

    // Scroll effect
    function onScroll() {
      if (navInner) {
        if (window.scrollY > 10) navInner.classList.add('scrolled');
        else navInner.classList.remove('scrolled');
      }
    }
    window.removeEventListener('scroll', onScroll);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Active section detection
    const desktopLinks = document.querySelectorAll('.nav-desktop .nav-link');
    const mobileLinks = document.querySelectorAll('.nav-mobile-links .nav-mobile-link');
    const sections = ['hero', 'sobre', 'servicos', 'portfolio', 'contato'];

    function setActive(sectionId) {
      desktopLinks.forEach(link => {
        link.classList.toggle('nav-link-active', link.dataset.section === sectionId);
      });
      mobileLinks.forEach(link => {
        link.classList.toggle('nav-mobile-link-active', link.dataset.section === sectionId);
      });
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id || entry.target.dataset.section;
          if (id) setActive(id);
        }
      });
    }, { rootMargin: '-20% 0px -60% 0px', threshold: 0 });

    sections.forEach(id => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });

    // For /blog page, always highlight Blog
    if (window.location.pathname.startsWith('/blog')) {
      setActive('blog');
    }
  }

  document.addEventListener('astro:page-load', initNav);
  document.addEventListener('DOMContentLoaded', initNav);
</script>
