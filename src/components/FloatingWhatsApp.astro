<style>
  .wa-float-container {
    position: fixed;
    bottom: 1.5rem;
    right: 1rem;
    z-index: 50;
  }
  @media (min-width: 768px) {
    .wa-float-container { bottom: 1.5rem; right: 1.5rem; }
  }
  .wa-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.75rem;
    height: 3.75rem;
    background: #25D366;
    border-radius: 50%;
    color: #fff;
    box-shadow: 0 4px 15px rgba(37,211,102,0.4);
    transition: all 0.3s cubic-bezier(0.22,0.61,0.36,1);
    position: relative;
    text-decoration: none;
  }
  .wa-btn:hover {
    background: #20BD5C;
    transform: scale(1.1);
    box-shadow: 0 6px 25px rgba(37,211,102,0.5);
  }
  .wa-icon {
    width: 2rem;
    height: 2rem;
    position: relative;
    z-index: 2;
  }
  .wa-ping {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid #25D366;
    animation: wa-pulse 2s cubic-bezier(0,0,0.2,1) infinite;
  }
  @keyframes wa-pulse {
    0% { transform: scale(1); opacity: 0.6; }
    75%, 100% { transform: scale(1.5); opacity: 0; }
  }
  .wa-tooltip {
    position: absolute;
    bottom: calc(100% + 0.75rem);
    right: 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: #fff;
    color: #111;
    padding: 0.5rem 0.85rem;
    border-radius: 0.625rem;
    font-size: 0.8rem;
    font-weight: 400;
    white-space: nowrap;
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    opacity: 0;
    transform: translateY(6px);
    transition: all 0.4s cubic-bezier(0.22,0.61,0.36,1);
    pointer-events: none;
    border: 1px solid #f0f0f0;
  }
  .wa-tooltip-text strong { font-weight: 700; color: #111; }
  .wa-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    right: 1.25rem;
    border: 6px solid transparent;
    border-top-color: #fff;
  }
  #wa-float:hover .wa-tooltip {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 767px) {
    .wa-btn {
      width: 4rem;
      height: 4rem;
      box-shadow: 0 4px 20px rgba(37,211,102,0.5);
    }
    .wa-icon {
      width: 2.25rem;
      height: 2.25rem;
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .wa-tooltip { display: none !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-ping { animation: none; }
    .wa-tooltip { animation: none; opacity: 1; transform: translateY(0); }
  }
</style>
